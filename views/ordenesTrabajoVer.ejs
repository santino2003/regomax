<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalle Orden de Trabajo - Regomax</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/assets/css/home.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="/home">
                <img src="/assets/img/regomax.png" alt="Regomax Logo" class="bg-white rounded p-1">
                <span class="ms-2 fw-bold">Regomax S.A.</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item user-welcome me-3">
                        <span class="text-light">BIENVENIDO/A, <b><%= username %></b></span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#"><i class="bi bi-globe me-1"></i> Ver sitio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#" id="logout-link"><i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container my-4">
        <div class="menu-container p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="menu-heading mb-0">
                    <i class="bi bi-clipboard2-check me-2"></i>Orden de Trabajo <%= ordenTrabajo.id %>
                </h4>
                <div>
                    <a href="/ordenes-trabajo/<%= ordenTrabajo.id %>/imprimir" class="btn btn-outline-dark me-2" target="_blank">
                        <i class="bi bi-printer me-2"></i>Imprimir
                    </a>
                    <a href="/ordenes-trabajo/<%= ordenTrabajo.id %>/editar" class="btn btn-primary">
                        <i class="bi bi-pencil me-2"></i>Editar
                    </a>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-4"><strong>Fecha Pedido:</strong><br><%= ordenTrabajo.fecha_pedido ? new Date(ordenTrabajo.fecha_pedido).toLocaleDateString('es-AR') : '-' %></div>
                <div class="col-md-4"><strong>Fecha Terminada:</strong><br><%= ordenTrabajo.fecha_terminada ? new Date(ordenTrabajo.fecha_terminada).toLocaleDateString('es-AR') : '-' %></div>
                <div class="col-md-4"><strong>Estado:</strong><br><span class="badge bg-secondary"><%= ordenTrabajo.estado %></span></div>
                <div class="col-md-4"><strong>Asignado a:</strong><br><%= ordenTrabajo.asignado_a || '-' %></div>
                <div class="col-md-4"><strong>Personas destinadas:</strong><br><%= ordenTrabajo.personas_destinadas != null ? ordenTrabajo.personas_destinadas : '-' %></div>
                <div class="col-md-4"><strong>Máquina:</strong><br><%= ordenTrabajo.maquina || '-' %></div>
                <div class="col-md-4"><strong>Mantenimiento:</strong><br><%= ordenTrabajo.mantenimiento || '-' %></div>
                <div class="col-md-4"><strong>Tipo:</strong><br><%= ordenTrabajo.tipo || '-' %></div>
                <div class="col-md-4"><strong>Creado por:</strong><br><%= ordenTrabajo.creado_por || '-' %></div>
                <div class="col-md-12">
                    <strong>Descripción:</strong>
                    <div class="border rounded p-3 mt-2 bg-light"><%= ordenTrabajo.descripcion %></div>
                </div>
            </div>

            <div class="mt-4">
                <a href="/ordenes-trabajo" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Volver
                </a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/assets/js/common.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="es-AR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fallas / Paradas - Regomax</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/home.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="/home">
                <img src="/assets/img/regomax.png" alt="Regomax Logo" class="bg-white rounded p-1">
                <span class="ms-2 fw-bold">Regomax S.A.</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item user-welcome me-3">
                        <span class="text-light">BIENVENIDO/A, <b><%= username %></b></span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#" id="logout-link"><i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container my-4">
        <div class="row mb-4">
            <div class="col">
                <div class="menu-container p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="menu-heading mb-0">
                            <i class="bi bi-exclamation-triangle me-2"></i>Fallas / Paradas
                        </h4>
                        <a href="/mantenimiento/fallas-paradas/nueva" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-2"></i>Nueva Falla / Parada
                        </a>
                    </div>

                    <form method="GET" action="/mantenimiento/fallas-paradas" class="row g-3 align-items-end mb-4">
                        <div class="col-md-2">
                            <label for="fecha_desde" class="form-label">Desde</label>
                            <input type="date" class="form-control" id="fecha_desde" name="fecha_desde" value="<%= filtros.fecha_desde %>">
                        </div>
                        <div class="col-md-2">
                            <label for="fecha_hasta" class="form-label">Hasta</label>
                            <input type="date" class="form-control" id="fecha_hasta" name="fecha_hasta" value="<%= filtros.fecha_hasta %>">
                        </div>
                        <div class="col-md-2">
                            <label for="maquina" class="form-label">Máquina</label>
                            <select class="form-select" id="maquina" name="maquina">
                                <option value="">Todas</option>
                                <% maquinas.forEach((maquina) => { %>
                                    <option value="<%= maquina.nombre %>" <%= filtros.maquina === maquina.nombre ? 'selected' : '' %>><%= maquina.nombre %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="falla_id" class="form-label">Falla</label>
                            <select class="form-select" id="falla_id" name="falla_id">
                                <option value="">Todas</option>
                                <% fallas.forEach((falla) => { %>
                                    <option value="<%= falla.id %>" <%= String(filtros.falla_id) === String(falla.id) ? 'selected' : '' %>><%= falla.nombre %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="tipo_parada" class="form-label">Tipo parada</label>
                            <select class="form-select" id="tipo_parada" name="tipo_parada">
                                <option value="">Todos</option>
                                <% tiposParada.forEach((tipo) => { %>
                                    <option value="<%= tipo %>" <%= filtros.tipo_parada === tipo ? 'selected' : '' %>><%= tipo %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-2 d-flex gap-2">
                            <button type="submit" class="btn btn-primary" title="Filtrar">
                                <i class="bi bi-search"></i>
                            </button>
                            <a href="/mantenimiento/fallas-paradas" class="btn btn-outline-secondary" title="Limpiar filtros">
                                <i class="bi bi-x-circle"></i>
                            </a>
                        </div>
                    </form>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="text-muted">
                            Seleccionadas: <span id="registrosSeleccionadosCount">0</span>
                        </div>
                        <div>
                            <button id="btnExportExcelSelected" class="btn btn-success me-2" disabled>
                                <i class="bi bi-file-earmark-excel me-1"></i>Exportar seleccionadas
                            </button>
                            <button id="btnExportExcelAll" class="btn btn-outline-success">
                                <i class="bi bi-file-earmark-excel me-1"></i>Exportar todas
                            </button>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle">
                            <thead>
                                <tr>
                                    <th><input type="checkbox" id="selectAllRegistros" class="form-check-input" title="Seleccionar todas"></th>
                                    <th>ID</th>
                                    <th>Fecha</th>
                                    <th>Hora</th>
                                    <th>Minutos afectados</th>
                                    <th>Máquina</th>
                                    <th>Falla</th>
                                    <th>Tipo parada</th>
                                    <th>Descripción</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (fallasParadas && fallasParadas.length > 0) { %>
                                    <% fallasParadas.forEach((registro) => { %>
                                        <tr>
                                            <td><input type="checkbox" class="form-check-input falla-parada-checkbox" value="<%= registro.id %>"></td>
                                            <td><strong><%= registro.id %></strong></td>
                                            <td><%= registro.fecha ? new Date(`${registro.fecha}T00:00:00`).toLocaleDateString('es-AR') : '-' %></td>
                                            <td><%= registro.hora || '-' %></td>
                                            <td><%= registro.minutos_afectados ?? '-' %></td>
                                            <td><%= registro.maquina || '-' %></td>
                                            <td><%= registro.falla_nombre || '-' %></td>
                                            <td><span class="badge bg-secondary"><%= registro.tipo_parada || '-' %></span></td>
                                            <td><%= registro.descripcion || '-' %></td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="/mantenimiento/fallas-paradas/<%= registro.id %>" class="btn btn-sm btn-outline-primary" title="Ver">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    <a href="/mantenimiento/fallas-paradas/<%= registro.id %>/editar" class="btn btn-sm btn-outline-secondary" title="Editar">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="10" class="text-center">No hay fallas o paradas registradas</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <% if (pagination && pagination.totalPages > 1) { %>
                        <%
                            const buildPageUrl = (page) => {
                                const params = new URLSearchParams(filtros || {});
                                params.set('page', page);
                                params.set('limit', pagination.limit);
                                return `/mantenimiento/fallas-paradas?${params.toString()}`;
                            };
                        %>
                        <nav aria-label="Navegación de fallas y paradas">
                            <ul class="pagination justify-content-center">
                                <li class="page-item <%= pagination.page === 1 ? 'disabled' : '' %>">
                                    <a class="page-link" href="<%= buildPageUrl(pagination.page - 1) %>">Anterior</a>
                                </li>
                                <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                                    <li class="page-item <%= pagination.page === i ? 'active' : '' %>">
                                        <a class="page-link" href="<%= buildPageUrl(i) %>"><%= i %></a>
                                    </li>
                                <% } %>
                                <li class="page-item <%= pagination.page === pagination.totalPages ? 'disabled' : '' %>">
                                    <a class="page-link" href="<%= buildPageUrl(pagination.page + 1) %>">Siguiente</a>
                                </li>
                            </ul>
                        </nav>
                    <% } %>

                    <div class="mt-3">
                        <a href="/home" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-2"></i>Volver al inicio
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="/assets/js/common.js"></script>
    <script>
        $(document).ready(function() {
            $('#maquina, #falla_id').select2({
                theme: 'bootstrap-5',
                width: '100%',
                placeholder: 'Buscar máquina',
                allowClear: true
            });

            function actualizarBotonExportar() {
                const seleccionadas = $('.falla-parada-checkbox:checked').length;
                $('#registrosSeleccionadosCount').text(seleccionadas);
                $('#btnExportExcelSelected').prop('disabled', seleccionadas === 0);
                $('#btnExportExcelSelected').html(
                    seleccionadas > 0
                        ? `<i class="bi bi-file-earmark-excel me-1"></i>Exportar (${seleccionadas})`
                        : '<i class="bi bi-file-earmark-excel me-1"></i>Exportar seleccionadas'
                );
            }

            $('#selectAllRegistros').on('change', function() {
                $('.falla-parada-checkbox').prop('checked', $(this).prop('checked'));
                actualizarBotonExportar();
            });

            $('.falla-parada-checkbox').on('change', function() {
                const total = $('.falla-parada-checkbox').length;
                const seleccionadas = $('.falla-parada-checkbox:checked').length;
                $('#selectAllRegistros')
                    .prop('checked', total > 0 && total === seleccionadas)
                    .prop('indeterminate', seleccionadas > 0 && seleccionadas < total);
                actualizarBotonExportar();
            });

            $('#btnExportExcelSelected').on('click', function() {
                const ids = $('.falla-parada-checkbox:checked').map(function() {
                    return $(this).val();
                }).get();
                if (ids.length === 0) return;
                window.location.href = `/api/fallas-paradas/exportar-excel?ids=${encodeURIComponent(ids.join(','))}`;
            });

            $('#btnExportExcelAll').on('click', function() {
                const params = new URLSearchParams(window.location.search);
                params.delete('page');
                params.delete('limit');
                const query = params.toString();
                window.location.href = `/api/fallas-paradas/exportar-excel${query ? '?' + query : ''}`;
            });
        });
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="es-AR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalle Falla / Parada - Regomax</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/assets/css/home.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="/home">
                <img src="/assets/img/regomax.png" alt="Regomax Logo" class="bg-white rounded p-1">
                <span class="ms-2 fw-bold">Regomax S.A.</span>
            </a>
            <div class="collapse navbar-collapse show">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item user-welcome me-3">
                        <span class="text-light">BIENVENIDO/A, <b><%= username %></b></span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#" id="logout-link"><i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container my-4">
        <div class="menu-container p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="menu-heading mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>Detalle Falla / Parada #<%= fallaParada.id %>
                </h4>
                <a href="/mantenimiento/fallas-paradas/<%= fallaParada.id %>/editar" class="btn btn-warning">
                    <i class="bi bi-pencil me-2"></i>Editar
                </a>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-4"><strong>Fecha:</strong><p class="mb-0"><%= fallaParada.fecha ? new Date(`${fallaParada.fecha}T00:00:00`).toLocaleDateString('es-AR') : '-' %></p></div>
                        <div class="col-md-4"><strong>Hora:</strong><p class="mb-0"><%= fallaParada.hora || '-' %></p></div>
                        <div class="col-md-4"><strong>Minutos afectados:</strong><p class="mb-0"><%= fallaParada.minutos_afectados ?? '-' %></p></div>
                    </div>
                    <hr>
                    <div class="row mb-3">
                        <div class="col-md-4"><strong>Máquina:</strong><p class="mb-0"><%= fallaParada.maquina || '-' %></p></div>
                        <div class="col-md-4"><strong>Falla:</strong><p class="mb-0"><%= fallaParada.falla_nombre || '-' %></p></div>
                        <div class="col-md-4"><strong>Tipo parada:</strong><p class="mb-0"><span class="badge bg-secondary"><%= fallaParada.tipo_parada || '-' %></span></p></div>
                    </div>
                    <hr>
                    <div class="mb-3"><strong>Descripción:</strong><p class="mb-0 text-break"><%= fallaParada.descripcion || '-' %></p></div>
                    <div><strong>Observaciones:</strong><p class="mb-0 text-break"><%= fallaParada.observaciones || '-' %></p></div>
                </div>
            </div>

            <div class="mt-4">
                <a href="/mantenimiento/fallas-paradas" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Volver al listado
                </a>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/assets/js/common.js"></script>
</body>
</html>

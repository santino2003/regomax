<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nueva Orden de Trabajo - Regomax</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/home.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="/home">
                <img src="/assets/img/regomax.png" alt="Regomax Logo" class="bg-white rounded p-1">
                <span class="ms-2 fw-bold">Regomax S.A.</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item user-welcome me-3">
                        <span class="text-light">BIENVENIDO/A, <b><%= username %></b></span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#"><i class="bi bi-globe me-1"></i> Ver sitio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#" id="logout-link"><i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container my-4">
        <div class="row mb-4">
            <div class="col">
                <div class="menu-container p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="menu-heading mb-0">
                            <i class="bi bi-plus-circle me-2"></i>Nueva Orden de Trabajo
                        </h4>
                    </div>

                    <div id="alertPlaceholder"></div>

                    <form id="formNuevaOrdenTrabajo" class="needs-validation" novalidate>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label for="fecha_pedido" class="form-label">Fecha Pedido <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="fecha_pedido" name="fecha_pedido" required>
                                <div class="invalid-feedback">Ingrese la fecha de pedido.</div>
                            </div>
                            <div class="col-md-4">
                                <label for="fecha_terminada" class="form-label">Fecha Terminada</label>
                                <input type="date" class="form-control" id="fecha_terminada" name="fecha_terminada">
                            </div>
                            <div class="col-md-4">
                                <label for="estado" class="form-label">Estado <span class="text-danger">*</span></label>
                                <select class="form-select" id="estado" name="estado" required>
                                    <option value="">Seleccione un estado</option>
                                    <option value="Pendiente">Pendiente</option>
                                    <option value="En Proceso">En Proceso</option>
                                    <option value="Cerrada">Cerrada</option>
                                </select>
                                <div class="invalid-feedback">Seleccione un estado.</div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label for="asignado_a" class="form-label">Asignado a</label>
                                <select class="form-select" id="asignado_a" name="asignado_a">
                                    <option value="">Seleccione un usuario</option>
                                    <% usuarios.forEach((usuario) => { %>
                                        <option value="<%= usuario.username %>"><%= usuario.username %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="personas_destinadas" class="form-label">Personas destinadas</label>
                                <input type="number" class="form-control" id="personas_destinadas" name="personas_destinadas" min="0" step="1">
                                <div class="invalid-feedback">Ingrese un número entero mayor o igual a cero.</div>
                            </div>
                            <div class="col-md-4">
                                <label for="maquina" class="form-label">Máquina</label>
                                <select class="form-select" id="maquina" name="maquina">
                                    <option value="">Seleccione una máquina</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label for="descripcion" class="form-label">Descripción <span class="text-danger">*</span></label>
                                <textarea class="form-control" id="descripcion" name="descripcion" rows="4" required></textarea>
                                <div class="invalid-feedback">Ingrese una descripción.</div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Mantenimiento <span class="text-danger">*</span></label>
                                <div class="d-flex flex-wrap gap-3">
                                    <% ['Correctivo', 'Preventivo', 'Predictivo', 'Otro'].forEach((opcion) => { %>
                                        <div class="form-check">
                                            <input class="form-check-input mantenimiento-option" type="radio" name="mantenimiento" value="<%= opcion %>" id="mantenimiento<%= opcion %>">
                                            <label class="form-check-label" for="mantenimiento<%= opcion %>"><%= opcion %></label>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Tipo <span class="text-danger">*</span></label>
                                <div class="d-flex flex-wrap gap-3">
                                    <% ['Electrico', 'Mecanico', 'Hidraulico', 'Otro'].forEach((opcion) => { %>
                                        <div class="form-check">
                                            <input class="form-check-input tipo-option" type="radio" name="tipo" value="<%= opcion %>" id="tipo<%= opcion %>">
                                            <label class="form-check-label" for="tipo<%= opcion %>"><%= opcion %></label>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col">
                                <button type="submit" id="submitBtn" class="btn btn-primary">
                                    <i class="bi bi-save me-2"></i>Guardar Orden de Trabajo
                                </button>
                                <a href="/ordenes-trabajo" class="btn btn-outline-secondary ms-2">
                                    <i class="bi bi-x-circle me-2"></i>Cancelar
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="/assets/js/common.js"></script>
    <script>
        $(document).ready(function() {
            const form = $('#formNuevaOrdenTrabajo');

            $('#asignado_a').select2({
                theme: 'bootstrap-5',
                width: '100%',
                placeholder: 'Buscar usuario',
                allowClear: true
            });

            form.on('submit', function(e) {
                e.preventDefault();

                if (!form[0].checkValidity()) {
                    e.stopPropagation();
                    form.addClass('was-validated');
                    return;
                }

                const mantenimiento = $('.mantenimiento-option:checked').val();
                const tipo = $('.tipo-option:checked').val();

                if (!mantenimiento) {
                    showAlert('Seleccione una opción de mantenimiento', 'warning');
                    return;
                }

                if (!tipo) {
                    showAlert('Seleccione un tipo', 'warning');
                    return;
                }

                const submitBtn = $('#submitBtn');
                const originalText = submitBtn.html();
                submitBtn.html('<span class="spinner-border spinner-border-sm me-2"></span>Guardando...').prop('disabled', true);

                $.ajax({
                    url: '/api/ordenes-trabajo',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        fecha_pedido: $('#fecha_pedido').val(),
                        fecha_terminada: $('#fecha_terminada').val(),
                        estado: $('#estado').val(),
                        asignado_a: $('#asignado_a').val(),
                        personas_destinadas: $('#personas_destinadas').val(),
                        maquina: $('#maquina').val(),
                        descripcion: $('#descripcion').val(),
                        mantenimiento,
                        tipo
                    }),
                    success: function(response) {
                        showAlert(`Orden de trabajo ${response.id} creada exitosamente`, 'success');
                        setTimeout(() => {
                            window.location.href = '/ordenes-trabajo';
                        }, 1200);
                    },
                    error: function(xhr) {
                        const error = xhr.responseJSON?.error || 'Error al crear la orden de trabajo';
                        showAlert(error, 'danger');
                        submitBtn.html(originalText).prop('disabled', false);
                    }
                });
            });
        });
    </script>
</body>
</html>

        function cargarProveedoresPorBien(bienId, $select, proveedorSeleccionado = null) {
            $select.html('<option value="">Cargando...</option>');
            
            $.ajax({
                url: `/api/ordenes-compra/bienes/${bienId}/proveedores`,
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${token}`
                },
                success: function(response) {
                    if (response.success && response.data && response.data.length > 0) {
                        let options = '<option value="">---------</option>';
                        let precioSeleccionado = null;
                        
                        response.data.forEach(proveedor => {
                            const nombre = proveedor.nombre || 'Sin nombre';
                            const precio = proveedor.precio ? ` - ${proveedor.moneda} ${proveedor.precio}` : '';
                            const selected = proveedorSeleccionado && proveedor.id == proveedorSeleccionado ? 'selected' : '';
                            options += `<option value="${proveedor.id}" data-precio="${proveedor.precio || 0}" ${selected}>${nombre}${precio}</option>`;
                            
                            // Guardar el precio del proveedor seleccionado
                            if (selected && proveedor.precio) {
                                precioSeleccionado = proveedor.precio;
                            }
                        });
                        
                        $select.html(options);
                        
                        // Si hay un proveedor seleccionado con precio, establecerlo automáticamente
                        if (precioSeleccionado) {
                            const itemId = $select.closest('[data-item]').data('item');
                            $(`[data-item="${itemId}"] .item-precio`).val(precioSeleccionado);
                            calcularMontoTotal();
                        }
                    } else {
                        $select.html('<option value="">Sin proveedores asociados</option>');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error al cargar proveedores:', error);
                    $select.html('<option value="">Error al cargar proveedores</option>');
                }
            });
        }

        function actualizarListaArchivosNuevos() {
            const listaArchivos = $('#listaArchivosNuevos');
            
            if (archivosNuevos.length === 0) {
                listaArchivos.html('<small class="text-muted">No hay archivos nuevos seleccionados</small>');
                return;
            }
            
            let html = '<div class="list-group list-group-flush">';
            archivosNuevos.forEach((archivo, index) => {
                const tamañoMB = (archivo.size / (1024 * 1024)).toFixed(2);
                const icono = obtenerIconoArchivo(archivo.name);
                
                html += `
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2 px-2">
                        <div class="d-flex align-items-center">
                            <i class="bi ${icono} me-2 text-primary"></i>
                            <div>
                                <small class="fw-bold d-block">${archivo.name}</small>
                                <small class="text-muted">${tamañoMB} MB</small>
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-danger" onclick="eliminarArchivoNuevo(${index})" title="Eliminar">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                `;
            });
            html += '</div>';
            
            listaArchivos.html(html);
        }

        function obtenerIconoArchivo(nombre) {
            const extension = nombre.split('.').pop().toLowerCase();
            const iconos = {
                'pdf': 'bi-file-pdf-fill',
                'doc': 'bi-file-word-fill',
                'docx': 'bi-file-word-fill',
                'xls': 'bi-file-excel-fill',
                'xlsx': 'bi-file-excel-fill',
                'jpg': 'bi-file-image-fill',
                'jpeg': 'bi-file-image-fill',
                'png': 'bi-file-image-fill',
                'dwg': 'bi-file-earmark-fill'
            };
            return iconos[extension] || 'bi-file-earmark-fill';
        }

        function eliminarArchivoNuevo(index) {
            archivosNuevos.splice(index, 1);
            actualizarListaArchivosNuevos();
        }

        function eliminarArchivoServidor(nombreArchivo) {
            if (confirm('¿Estás seguro de eliminar este archivo del servidor?')) {
                // Marcar para eliminación
                archivosEliminar.push(nombreArchivo);
                
                // Ocultar de la vista
                $(`[data-archivo="${nombreArchivo}"]`).fadeOut(300, function() {
                    $(this).remove();
                    
                    // Si no quedan archivos, ocultar toda la sección
                    if ($('#archivos-actuales .d-flex').length === 0) {
                        $('#archivos-actuales').parent().remove();
                    }
                });
            }
        }

        function eliminarItem(itemId) {
            const itemsCount = $('.item-row').length;
            if (itemsCount <= 1) {
                mostrarAlerta('Debe haber al menos un item en la orden', 'warning');
                return;
            }
            $(`[data-item="${itemId}"]`).remove();
            calcularMontoTotal(); // Recalcular cuando se elimina un item
        }

    // ==================== FUNCIONES DE CUOTAS ====================
        
    // Indica si ya se cargaron cuotas guardadas desde el servidor (para no pisarlas)
    let cuotasCargadasDesdeServidor = false;

    function calcularMontoTotal() {
            let total = 0;
            
            $('.item-row').each(function() {
                const cantidad = parseFloat($(this).find('.item-cantidad').val()) || 0;
                const precio = parseFloat($(this).find('.item-precio').val()) || 0;
                total += cantidad * precio;
            });

            $('#montoTotalBienes').val(total.toFixed(2));
            actualizarMontoDisponible();
        }

        /**
         * Actualizar el monto disponible para cuotas (Total - Adelanto)
         */
        function actualizarMontoDisponible() {
            const montoTotal = parseFloat($('#montoTotalBienes').val()) || 0;
            const adelanto = parseFloat($('#monto_adelanto').val()) || 0;
            const disponible = montoTotal - adelanto;
            
            $('#montoDisponibleCuotas').val(disponible > 0 ? disponible.toFixed(2) : '0.00');
            
            // Si las cuotas vienen desde el servidor, no las regeneramos automáticamente
            // para no pisar montos/fechas ya guardados.
            if (cuotasCargadasDesdeServidor) {
                console.log('ℹ️ [CUOTAS] actualizarMontoDisponible no regenera cuotas porque vienen del servidor');
                return;
            }

            // Solo regenerar si no hay cuotas del servidor y ya hay filas
            if ($('#contrafactura').is(':checked') && $('#tablaCuotasOC tr').length > 0) {
                generarCuotasOC();
            }
        }

        /**
         * Generar las filas de cuotas editables para Orden de Compra
         */
        // ==================== FUNCIONES DE CUOTAS ====================
        
        function cargarCuotasDesdeAPI() {
            console.log(`📋 Cargando cuotas desde API para orden: ${ordenId}`);
            
            $.ajax({
                url: `/pagos/orden/${ordenId}/cuotas-contrafactura`,
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${token}`
                },
                success: function(response) {
                    console.log('✅ Respuesta de cuotas:', response);
                    
                    // Verificar si hay cuotas en la respuesta
                    const cuotas = response.data && response.data.cuotas ? response.data.cuotas : 
                                   (response.cuotas ? response.cuotas : []);
                    
                    console.log('📊 Cuotas encontradas:', cuotas);
                    
                    if (cuotas && cuotas.length > 0) {
                        // Cargar cuotas existentes
                        cuotasExistentesServidor = cuotas;
                        cuotasCargadasDesdeServidor = true;
                        console.log('🔄 Llamando a cargarCuotasExistentes con:', cuotasExistentesServidor);
                        cargarCuotasExistentes();
                        
                        // Cargar adelanto si existe
                        if (response.data && response.data.adelanto) {
                            const adelanto = response.data.adelanto;
                            console.log('💰 Adelanto desde API:', adelanto);
                            
                            // Usar los IDs correctos que están en la vista
                            $('#monto_adelanto').val(adelanto.monto).trigger('change');
                            $('#fecha_adelanto').val(adelanto.fecha);
                            
                            console.log('✅ Adelanto cargado en los inputs');
                            console.log('   Monto:', $('#monto_adelanto').val());
                            console.log('   Fecha:', $('#fecha_adelanto').val());
                        } else {
                            console.log('⚠️ No hay adelanto en la respuesta');
                        }
                    } else {
                        console.log('⚠️ No hay cuotas existentes, inicializando vacío');
                        cuotasCargadasDesdeServidor = false;
                        generarCuotasOC();
                    }
                },
                error: function(xhr, status, error) {
                    console.error('❌ Error al cargar cuotas desde API:', error);
                    console.error('Respuesta:', xhr.responseJSON);
                    console.error('Status:', xhr.status);
                    console.error('URL intentada:', `/pagos/orden/${ordenId}/cuotas-contrafactura`);
                // Si falla, inicializar vacío
                cuotasCargadasDesdeServidor = false;
                generarCuotasOC();
                }
            });
        }
        
        function cargarCuotasExistentes() {
            console.log('📥 cargarCuotasExistentes llamada con:', cuotasExistentesServidor);
            console.log('📥 Cantidad de cuotas:', cuotasExistentesServidor ? cuotasExistentesServidor.length : 0);
            
            if (!cuotasExistentesServidor || cuotasExistentesServidor.length === 0) {
                console.log('⚠️ No hay cuotas existentes para cargar');
                generarCuotasOC(); // Inicializar vacío
                return;
            }

            console.log(`📊 Procesando ${cuotasExistentesServidor.length} cuotas existentes`);
            
            // Establecer la cantidad de cuotas
            $('#cantidadCuotasOC').val(cuotasExistentesServidor.length);
            $('#badgeTotalCuotasOC').text(cuotasExistentesServidor.length);
            
            // Calcular el total de las cuotas
            let montoTotal = 0;
            cuotasExistentesServidor.forEach(cuota => {
                montoTotal += parseFloat(cuota.monto || 0);
            });
            
            console.log('💰 Monto total calculado:', montoTotal);
            $('#montoDisponibleCuotas').val(montoTotal.toFixed(2));
            
            // Construir HTML de las cuotas
            let html = '';
            for (let index = 0; index < cuotasExistentesServidor.length; index++) {
                const cuota = cuotasExistentesServidor[index];
                const numCuota = index + 1;
                
                // Convertir fecha al formato correcto (YYYY-MM-DD)
                let fechaFormato = cuota.fecha || '';
                if (fechaFormato && typeof fechaFormato === 'string') {
                    // Si viene en formato ISO (2026-03-24T00:00:00Z), extraer solo la fecha
                    if (fechaFormato.includes('T')) {
                        fechaFormato = fechaFormato.split('T')[0];
                    }
                }
                
                console.log(`  🔹 Cuota ${numCuota}: fecha=${fechaFormato}, monto=${cuota.monto}`);
                
                html += '<tr>';
                html += `  <td class="text-center fw-bold">${numCuota}</td>`;
                html += `  <td><input type="date" class="form-control form-control-sm fecha-cuota-oc" name="cuotasOC[${index}][fecha]" value="${fechaFormato || ''}" required></td>`;
                html += `  <td><div class="input-group input-group-sm"><span class="input-group-text">$</span><input type="number" class="form-control monto-cuota-oc" name="cuotasOC[${index}][monto]" value="${parseFloat(cuota.monto || 0).toFixed(2)}" step="0.01" min="0.01" oninput="actualizarTotalesCuotasOC()" required></div></td>`;
                html += '</tr>';
            }
            
            console.log('📝 HTML generado con', cuotasExistentesServidor.length, 'filas');
            console.log('📝 HTML:', html);
            
            // Limpiar la tabla primero
            $('#tablaCuotasOC').empty();
            
            // Insertar el HTML
            $('#tablaCuotasOC').html(html);
            
            // Verificar que se insertó
            const rowCount = $('#tablaCuotasOC tr').length;
            console.log(`✅ Se insertaron ${rowCount} filas en la tabla`);
            
            actualizarTotalesCuotasOC();
            
            console.log(`✅ ${cuotasExistentesServidor.length} cuotas cargadas exitosamente en el DOM`);
        }

        function generarCuotasOC() {
            const cantidadCuotas = parseInt($('#cantidadCuotasOC').val()) || 0;
            
            if (cantidadCuotas < 1 || cantidadCuotas > 60) {
                $('#tablaCuotasOC').html('<tr><td colspan="3" class="text-center text-muted">Ingrese una cantidad válida de cuotas (1-60)</td></tr>');
                $('#badgeTotalCuotasOC').text('0');
                actualizarTotalesCuotasOC();
                return;
            }

            $('#badgeTotalCuotasOC').text(cantidadCuotas);

            const montoDisponible = parseFloat($('#montoDisponibleCuotas').val()) || 0;
            
            // Calcular fecha base (mañana)
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);

            // Calcular monto equitativo como sugerencia
            const montoCuota = (montoDisponible / cantidadCuotas).toFixed(2);

            const tbody = $('#tablaCuotasOC');
            tbody.empty();

            for (let i = 0; i < cantidadCuotas; i++) {
                const fechaCuota = new Date(tomorrow);
                fechaCuota.setMonth(fechaCuota.getMonth() + i);
                const fechaFormatted = fechaCuota.toISOString().split('T')[0];

                const row = $(`
                    <tr>
                        <td class="align-middle text-center">
                            <strong>Cuota ${i + 1}</strong>
                        </td>
                        <td>
                            <input type="date" 
                                   class="form-control form-control-sm" 
                                   id="fechaCuota_${i}" 
                                   value="${fechaFormatted}"
                                   onchange="actualizarTotalesCuotasOC()"
                                   required>
                        </td>
                        <td>
                            <input type="number" 
                                   class="form-control form-control-sm" 
                                   id="montoCuota_${i}" 
                                   step="0.01"
                                   min="0.01"
                                   value="${montoCuota}"
                                   onchange="actualizarTotalesCuotasOC()"
                                   required>
                        </td>
                    </tr>
                `);
                tbody.append(row);
            }

            actualizarTotalesCuotasOC();
        }

        /**
         * Actualizar totales de cuotas de Orden de Compra
         */
        function actualizarTotalesCuotasOC() {
            const cantidadCuotas = parseInt($('#cantidadCuotasOC').val()) || 0;
            const montoDisponible = parseFloat($('#montoDisponibleCuotas').val()) || 0;
            let totalCuotas = 0;

            for (let i = 0; i < cantidadCuotas; i++) {
                const inputMonto = $(`#montoCuota_${i}`);
                if (inputMonto.length) {
                    const monto = parseFloat(inputMonto.val()) || 0;
                    totalCuotas += monto;
                }
            }

            const diferencia = totalCuotas - montoDisponible;

            $('#totalCuotasOC').text('$' + totalCuotas.toFixed(2));
            $('#totalPagarCuotas').text('$' + totalCuotas.toFixed(2));
            
            const $diferenciaElement = $('#diferenciaCuotas');
            
            if (diferencia > 0.01) {
                $diferenciaElement.text('+$' + diferencia.toFixed(2));
                $diferenciaElement.removeClass('text-success text-muted').addClass('text-danger');
            } else if (diferencia < -0.01) {
                $diferenciaElement.text('$' + diferencia.toFixed(2));
                $diferenciaElement.removeClass('text-danger text-muted').addClass('text-success');
            } else {
                $diferenciaElement.text('$0.00');
                $diferenciaElement.removeClass('text-danger text-success').addClass('text-muted');
            }
        }

        // ==================== FIN FUNCIONES DE CUOTAS ====================

        function guardarOrden() {
            // Validar cuotas si es contrafactura
            if ($('#contrafactura').is(':checked')) {
                const cantidadCuotas = parseInt($('#cantidadCuotasOC').val()) || 0;
                
                if (cantidadCuotas < 1) {
                    mostrarAlerta('Debe configurar al menos una cuota para órdenes a contrafactura', 'warning');
                    return;
                }
                
                // Validar que todas las cuotas tengan fecha y monto
                let cuotasValidas = true;
                $('.fecha-cuota-oc').each(function(index) {
                    const fecha = $(this).val();
                    const monto = parseFloat($('.monto-cuota-oc').eq(index).val()) || 0;
                    
                    if (!fecha || monto <= 0) {
                        mostrarAlerta(`La cuota ${index + 1} debe tener fecha y monto válidos`, 'warning');
                        cuotasValidas = false;
                        return false;
                    }
                });
                
                if (!cuotasValidas) return;
            }

            const formData = new FormData();
            
            // Campos generales
            formData.append('condicion', $('#condicion').val());
            formData.append('fecha_entrega_solicitada', $('#fecha_entrega_solicitada').val());
            formData.append('fecha_entrega_proveedor', $('#fecha_entrega_proveedor').val());
            formData.append('asunto', $('#asunto').val());
            formData.append('contrafactura', $('#contrafactura').is(':checked') ? 'true' : 'false');
            
            // Si es contrafactura, incluir adelanto y cuotas
            if ($('#contrafactura').is(':checked')) {
                formData.append('monto_adelanto', $('#monto_adelanto').val() || '');
                formData.append('moneda_adelanto', $('#moneda_adelanto').val() || 'ARS');
                formData.append('fecha_adelanto', $('#fecha_adelanto').val() || '');
                
                // Recopilar cuotas desde la tabla
                const cuotas = [];
                $('.fecha-cuota-oc').each(function(index) {
                    const fecha = $(this).val();
                    const monto = parseFloat($('.monto-cuota-oc').eq(index).val()) || 0;
                    
                    cuotas.push({
                        fecha: fecha,
                        monto: monto,
                        moneda: 'ARS' // Por ahora todas en ARS
                    });
                });
                
                if (cuotas.length > 0) {
                    formData.append('cuotas', JSON.stringify(cuotas));
                    console.log('📋 Cuotas a guardar:', cuotas);
                }
            }
            
            // Archivos nuevos a agregar
            if (archivosNuevos.length > 0) {
                archivosNuevos.forEach(archivo => {
                    formData.append('archivos', archivo);
                });
            }

            // Archivos del servidor a eliminar
            if (archivosEliminar.length > 0) {
                formData.append('archivos_eliminar', JSON.stringify(archivosEliminar));
            }

            // Items
            const items = [];
            $('.item-row').each(function() {
                const $item = $(this);
                const itemData = $item.find('input[name$="[id]"]').val();
                const cantidadRecibida = $item.find('input[name$="[cantidad_recibida]"]').val();
                
                items.push({
                    id: itemData ? parseInt(itemData) : null,
                    bien_id: parseInt($item.find('select[name$="[bien_id]"]').val()),
                    centro_costo: $item.find('select[name$="[centro_costo]"]').val() || null,
                    descripcion: $item.find('textarea[name$="[descripcion]"]').val(),
                    cantidad: parseFloat($item.find('input[name$="[cantidad]"]').val()),
                    cantidad_recibida: cantidadRecibida ? parseFloat(cantidadRecibida) : 0,
                    unidad_medida_id: $item.find('select[name$="[unidad_medida_id]"]').val() ? parseInt($item.find('select[name$="[unidad_medida_id]"]').val()) : null,
                    proveedor_sugerido_id: $item.find('select[name$="[proveedor_sugerido_id]"]').val() ? parseInt($item.find('select[name$="[proveedor_sugerido_id]"]').val()) : null
                });
            });

            formData.append('items', JSON.stringify(items));

            $('#btnGuardar').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Guardando...');

            $.ajax({
                url: `/api/ordenes-compra/${ordenId}`,
                method: 'PUT',
                headers: { 'Authorization': `Bearer ${token}` },
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    mostrarAlerta('Orden de compra actualizada exitosamente', 'success');
                    setTimeout(() => {
                        window.location.href = `/ordenes-compra/${ordenId}`;
                    }, 1500);
                },
                error: function(xhr) {
                    $('#btnGuardar').prop('disabled', false).html('<i class="bi bi-save me-1"></i>Guardar Cambios');
                    const error = xhr.responseJSON?.error || 'Error al actualizar la orden';
                    mostrarAlerta(error, 'danger');
                }
            });
        }

        function mostrarAlerta(mensaje, tipo) {
            const alertHtml = `
                <div class="alert alert-${tipo} alert-dismissible fade show" role="alert">
                    ${mensaje}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            $('#alertPlaceholder').html(alertHtml);
            window.scrollTo(0, 0);
        }
    </script>
</body>
</html>

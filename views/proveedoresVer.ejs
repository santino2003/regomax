<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalle Proveedor - Regomax</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom styles -->
    <link rel="stylesheet" href="/assets/css/home.css">
</head>
<body data-allow-back-navigation="true" data-return-list-path="/proveedores">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="/home">
                <img src="/assets/img/regomax.png" alt="Regomax Logo" class="bg-white rounded p-1">
                <span class="ms-2 fw-bold">Regomax S.A.</span>
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item user-welcome me-3">
                        <span class="text-light">BIENVENIDO/A, <b><%= username %></b></span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#"><i class="bi bi-globe me-1"></i> Ver sitio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#" id="logout-link"><i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container my-4">
        <div class="row mb-4">
            <div class="col">
                <div class="menu-container p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="menu-heading mb-0">
                            <i class="bi bi-person-lines-fill me-2"></i>Detalle del Proveedor
                        </h4>
                        <div>
                            <a href="/proveedores/editar/<%= proveedor.id %>" class="btn btn-warning" data-preserve-return-to>
                                <i class="bi bi-pencil me-2"></i>Editar
                            </a>
                            <button class="btn btn-danger ms-2 btn-delete" data-id="<%= proveedor.id %>" data-nombre="<%= proveedor.nombre %>">
                                <i class="bi bi-trash me-2"></i>Eliminar
                            </button>
                        </div>
                    </div>
                    
                    <div class="card">
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Nombre:</label>
                                    <p class="form-control-plaintext"><%= proveedor.nombre %></p>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Contacto:</label>
                                    <p class="form-control-plaintext"><%= proveedor.contacto %></p>
                                </div>
                            </div>
                            
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Teléfono:</label>
                                    <p class="form-control-plaintext"><%= proveedor.telefono || '-' %></p>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Email:</label>
                                    <p class="form-control-plaintext"><%= proveedor.email || '-' %></p>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Dirección:</label>
                                    <p class="form-control-plaintext"><%= proveedor.direccion || '-' %></p>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Sitio Web:</label>
                                    <p class="form-control-plaintext">
                                        <% if (proveedor.web) { %>
                                            <a href="<%= proveedor.web %>" target="_blank"><%= proveedor.web %></a>
                                        <% } else { %>
                                            -
                                        <% } %>
                                    </p>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Rubro:</label>
                                    <p class="form-control-plaintext"><%= proveedor.rubro || '-' %></p>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Responsable:</label>
                                    <p class="form-control-plaintext"><%= proveedor.responsable || '-' %></p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Sección de Bienes Asociados -->
                    <div class="card mt-4">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="bi bi-box-seam me-2"></i>Bienes Asociados (<%= (bienes && Array.isArray(bienes)) ? bienes.length : 0 %>)</h5>
                        </div>
                        <div class="card-body">
                            <% if (!bienes || !Array.isArray(bienes) || bienes.length === 0) { %>
                                <div class="alert alert-info mb-0">
                                    <i class="bi bi-info-circle me-2"></i>
                                    Este proveedor no tiene bienes asociados aún.
                                </div>
                            <% } else { %>
                                <div class="table-responsive">
                                    <table class="table table-hover table-striped">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Código</th>
                                                <th>Nombre</th>
                                                <th>Descripción</th>
                                                <th>Tipo</th>
                                                <th>Categoría</th>
                                                <th>Unidad</th>
                                                <th class="text-end">Precio</th>
                                                <th>Moneda</th>
                                                <th class="text-center">Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% bienes.forEach(bien => { %>
                                                <tr>
                                                    <td><%= bien.id %></td>
                                                    <td><strong><%= bien.nombre %></strong></td>
                                                    <td><%= bien.descripcion || '-' %></td>
                                                    <td>
                                                        <% if (bien.tipo === 'producto') { %>
                                                            <span class="badge bg-success">Producto</span>
                                                        <% } else { %>
                                                            <span class="badge bg-info">Insumo</span>
                                                        <% } %>
                                                    </td>
                                                    <td><%= bien.categoria || '-' %></td>
                                                    <td><%= bien.unidad_medida || '-' %></td>
                                                    <td class="text-end">
                                                        <strong><%= bien.precio ? Number(bien.precio).toLocaleString('es-AR', {minimumFractionDigits: 2, maximumFractionDigits: 2}) : '-' %></strong>
                                                    </td>
                                                    <td>
                                                        <% if (bien.moneda) { %>
                                                            <span class="badge bg-secondary"><%= bien.moneda %></span>
                                                        <% } else { %>
                                                            -
                                                        <% } %>
                                                    </td>
                                                    <td class="text-center">
                                                        <a href="/bienes/<%= bien.id %>" class="btn btn-sm btn-info" title="Ver detalles">
                                                            <i class="bi bi-eye"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            <% } %>
                        </div>
                    </div>
                    
                    <!-- Historial de Precios -->
                    <div class="card mt-4">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Historial de Precios</h5>
                        </div>
                        <div class="card-body">
                            <% if (!historialPrecios || !Array.isArray(historialPrecios) || historialPrecios.length === 0) { %>
                                <div class="alert alert-info mb-0">
                                    <i class="bi bi-info-circle me-2"></i>
                                    No hay historial de precios para este proveedor.
                                </div>
                            <% } else { %>
                                <div class="row g-2 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label small text-muted">Filtrar por bien</label>
                                        <input type="text" class="form-control form-control-sm" id="historialBienFilter" placeholder="Buscar bien...">
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small text-muted">Moneda</label>
                                        <select class="form-select form-select-sm" id="historialMonedaFilter">
                                            <option value="">Todas</option>
                                            <option value="ARS">ARS</option>
                                            <option value="USD">USD</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="table-responsive">
                                    <table id="historialPreciosProveedorTable" class="table table-hover table-striped">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Bien</th>
                                                <th class="text-end">Precio</th>
                                                <th>Moneda</th>
                                                <th>Fecha</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% historialPrecios.forEach(item => { %>
                                                <tr data-bien="<%= ((item.bien_nombre || item.bien_codigo || '').toString().toLowerCase()) %>" data-moneda="<%= (item.moneda || '').toUpperCase() %>">
                                                    <td>
                                                        <strong><%= item.bien_codigo || item.bien_id %></strong>
                                                        <div class="text-muted small"><%= item.bien_nombre || '-' %></div>
                                                    </td>
                                                    <td class="text-end">
                                                        <% if (item.precio != null) { %>
                                                            <strong><%= Number(item.precio).toLocaleString('es-AR', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></strong>
                                                        <% } else { %>
                                                            -
                                                        <% } %>
                                                    </td>
                                                    <td>
                                                        <% if (item.moneda) { %>
                                                            <span class="badge bg-secondary"><%= item.moneda %></span>
                                                        <% } else { %>
                                                            -
                                                        <% } %>
                                                    </td>
                                                    <td>
                                                        <small class="text-muted"><%= item.fecha_asignacion ? new Date(item.fecha_asignacion).toLocaleString('es-AR') : '-' %></small>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <div class="mt-4">
                        <a href="/proveedores" class="btn btn-secondary" data-return-to-list>
                            <i class="bi bi-arrow-left me-2"></i>Volver al Listado
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de Confirmación para Eliminar -->
    <div class="modal fade" id="deleteProveedorModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Eliminación</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>¿Está seguro que desea eliminar el proveedor <span id="deleteProveedorNombre" class="fw-bold"></span>?</p>
                    <p class="text-danger mb-0">¡Esta acción no se puede deshacer!</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger" id="confirmDelete">Eliminar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    
    <!-- Common JS (Para funcionalidades compartidas como logout) -->
    <script src="/assets/js/common.js"></script>
    
    <!-- Script para manejar eliminación -->
    <script>
        $(document).ready(function() {
            let proveedorIdToDelete = null;
            const deleteModal = new bootstrap.Modal(document.getElementById('deleteProveedorModal'));
            
            // Manejar clic en botón de eliminar
            $('.btn-delete').on('click', function() {
                proveedorIdToDelete = $(this).data('id');
                const proveedorNombre = $(this).data('nombre');
                
                $('#deleteProveedorNombre').text(proveedorNombre);
                deleteModal.show();
            });
            
            // Confirmar eliminación
            $('#confirmDelete').on('click', function() {
                if (!proveedorIdToDelete) return;
                
                // Deshabilitar botón mientras se procesa
                const btn = $(this);
                const originalText = btn.html();
                btn.html('<span class="spinner-border spinner-border-sm me-2"></span>Eliminando...').prop('disabled', true);
                
                // Realizar petición de eliminación
                fetch(`/api/proveedores/${proveedorIdToDelete}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Cerrar modal y redirigir
                        deleteModal.hide();
                        window.location.href = window.listReturnTo || '/proveedores';
                    } else {
                        // Cerrar modal y redirigir de todas formas
                        deleteModal.hide();
                        console.error('Error:', data.message || 'No se pudo eliminar el proveedor');
                        setTimeout(() => window.location.href = window.listReturnTo || '/proveedores', 500);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    deleteModal.hide();
                    setTimeout(() => window.location.href = window.listReturnTo || '/proveedores', 500);
                })
                .finally(() => {
                    // Restaurar botón
                    btn.html(originalText).prop('disabled', false);
                });
            });

            const bienFilter = $('#historialBienFilter');
            const monedaFilter = $('#historialMonedaFilter');

            function filtrarHistorial() {
                const bienValue = (bienFilter.val() || '').toLowerCase().trim();
                const monedaValue = (monedaFilter.val() || '').toUpperCase().trim();

                $('#historialPreciosProveedorTable tbody tr').each(function() {
                    const row = $(this);
                    const bien = row.data('bien') || '';
                    const moneda = (row.data('moneda') || '').toString().toUpperCase();

                    const matchBien = !bienValue || bien.includes(bienValue);
                    const matchMoneda = !monedaValue || moneda === monedaValue;

                    row.toggle(matchBien && matchMoneda);
                });
            }

            bienFilter.on('input', filtrarHistorial);
            monedaFilter.on('change', filtrarHistorial);
        });
    </script>
</body>
</html>

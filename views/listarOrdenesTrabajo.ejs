<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Órdenes de Trabajo - Regomax</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/home.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="/home">
                <img src="/assets/img/regomax.png" alt="Regomax Logo" class="bg-white rounded p-1">
                <span class="ms-2 fw-bold">Regomax S.A.</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item user-welcome me-3">
                        <span class="text-light">BIENVENIDO/A, <b><%= username %></b></span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#"><i class="bi bi-globe me-1"></i> Ver sitio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#" id="logout-link"><i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container my-4">
        <div class="row mb-4">
            <div class="col">
                <div class="menu-container p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="menu-heading mb-0">
                            <i class="bi bi-clipboard2-check me-2"></i>Órdenes de Trabajo
                        </h4>
                        <a href="/ordenes-trabajo/nueva" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-2"></i>Nueva Orden de Trabajo
                        </a>
                    </div>

                    <form method="GET" action="/ordenes-trabajo" class="row g-3 align-items-end mb-4">
                        <div class="col-md-2">
                            <label for="fecha_desde" class="form-label">Desde</label>
                            <input type="date" class="form-control" id="fecha_desde" name="fecha_desde" value="<%= filtros ? filtros.fecha_desde : '' %>">
                        </div>
                        <div class="col-md-2">
                            <label for="fecha_hasta" class="form-label">Hasta</label>
                            <input type="date" class="form-control" id="fecha_hasta" name="fecha_hasta" value="<%= filtros ? filtros.fecha_hasta : '' %>">
                        </div>
                        <div class="col-md-3">
                            <label for="maquina" class="form-label">Máquina</label>
                            <select class="form-select" id="maquina" name="maquina">
                                <option value="">Todas</option>
                                <% if (maquinas && maquinas.length > 0) { %>
                                    <% maquinas.forEach((maquina) => { %>
                                        <option value="<%= maquina.nombre %>" <%= filtros && filtros.maquina === maquina.nombre ? 'selected' : '' %>><%= maquina.nombre %></option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="mantenimiento" class="form-label">Mantenimiento</label>
                            <select class="form-select" id="mantenimiento" name="mantenimiento">
                                <option value="">Todos</option>
                                <% ['Correctivo', 'Preventivo', 'Predictivo', 'Otro'].forEach((opcion) => { %>
                                    <option value="<%= opcion %>" <%= filtros && filtros.mantenimiento === opcion ? 'selected' : '' %>><%= opcion %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="tipo" class="form-label">Tipo</label>
                            <select class="form-select" id="tipo" name="tipo">
                                <option value="">Todos</option>
                                <% ['Electrico', 'Mecanico', 'Hidraulico', 'Otro'].forEach((opcion) => { %>
                                    <option value="<%= opcion %>" <%= filtros && filtros.tipo === opcion ? 'selected' : '' %>><%= opcion %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-1 d-flex gap-2">
                            <button type="submit" class="btn btn-primary" title="Filtrar">
                                <i class="bi bi-search"></i>
                            </button>
                            <a href="/ordenes-trabajo" class="btn btn-outline-secondary" title="Limpiar filtros">
                                <i class="bi bi-x-circle"></i>
                            </a>
                        </div>
                    </form>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="text-muted">
                            Seleccionadas: <span id="ordenesSeleccionadasCount">0</span>
                        </div>
                        <div>
                            <button id="btnExportExcelSelected" class="btn btn-success me-2" disabled>
                                <i class="bi bi-file-earmark-excel me-1"></i>Exportar seleccionadas
                            </button>
                            <button id="btnExportExcelAll" class="btn btn-outline-success">
                                <i class="bi bi-file-earmark-excel me-1"></i>Exportar todas
                            </button>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>
                                        <input type="checkbox" id="selectAllOrdenes" class="form-check-input" title="Seleccionar todas">
                                    </th>
                                    <th>ID</th>
                                    <th>Fecha Pedido</th>
                                    <th>Fecha Terminada</th>
                                    <th>Estado</th>
                                    <th>Asignado a</th>
                                    <th>Personas</th>
                                    <th>Máquina</th>
                                    <th>Mantenimiento</th>
                                    <th>Tipo</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (ordenesTrabajo && ordenesTrabajo.length > 0) { %>
                                    <% ordenesTrabajo.forEach((orden) => { %>
                                        <tr>
                                            <td>
                                                <input type="checkbox" class="form-check-input orden-trabajo-checkbox" value="<%= orden.id %>">
                                            </td>
                                            <td><strong><%= orden.id %></strong></td>
                                            <td><%= orden.fecha_pedido ? new Date(orden.fecha_pedido).toLocaleDateString('es-AR') : '-' %></td>
                                            <td><%= orden.fecha_terminada ? new Date(orden.fecha_terminada).toLocaleDateString('es-AR') : '-' %></td>
                                            <td><span class="badge bg-secondary"><%= orden.estado %></span></td>
                                            <td><%= orden.asignado_a || '-' %></td>
                                            <td><%= orden.personas_destinadas != null ? orden.personas_destinadas : '-' %></td>
                                            <td><%= orden.maquina || '-' %></td>
                                            <td><%= orden.mantenimiento || '-' %></td>
                                            <td><%= orden.tipo || '-' %></td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="/ordenes-trabajo/<%= orden.id %>" class="btn btn-sm btn-outline-primary" title="Ver">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    <a href="/ordenes-trabajo/<%= orden.id %>/editar" class="btn btn-sm btn-outline-secondary" title="Editar">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    <a href="/ordenes-trabajo/<%= orden.id %>/imprimir" class="btn btn-sm btn-outline-dark" title="Imprimir" target="_blank">
                                                        <i class="bi bi-printer"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="11" class="text-center">No hay órdenes de trabajo registradas</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <% if (pagination && pagination.totalPages > 1) { %>
                        <%
                            const buildPageUrl = (page) => {
                                const params = new URLSearchParams(filtros || {});
                                params.set('page', page);
                                params.set('limit', pagination.limit);
                                return `/ordenes-trabajo?${params.toString()}`;
                            };
                        %>
                        <nav aria-label="Navegación de órdenes de trabajo">
                            <ul class="pagination justify-content-center">
                                <li class="page-item <%= pagination.page === 1 ? 'disabled' : '' %>">
                                    <a class="page-link" href="<%= buildPageUrl(pagination.page - 1) %>">Anterior</a>
                                </li>
                                <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                                    <li class="page-item <%= pagination.page === i ? 'active' : '' %>">
                                        <a class="page-link" href="<%= buildPageUrl(i) %>"><%= i %></a>
                                    </li>
                                <% } %>
                                <li class="page-item <%= pagination.page === pagination.totalPages ? 'disabled' : '' %>">
                                    <a class="page-link" href="<%= buildPageUrl(pagination.page + 1) %>">Siguiente</a>
                                </li>
                            </ul>
                        </nav>
                    <% } %>

                    <div class="mt-3">
                        <a href="/home" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-2"></i>Volver al inicio
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="/assets/js/common.js"></script>
    <script>
        $(document).ready(function() {
            $('#maquina').select2({
                theme: 'bootstrap-5',
                width: '100%',
                placeholder: 'Buscar máquina',
                allowClear: true
            });

            function updateExportButton() {
                const selectedCount = $('.orden-trabajo-checkbox:checked').length;
                $('#ordenesSeleccionadasCount').text(selectedCount);
                $('#btnExportExcelSelected').prop('disabled', selectedCount === 0);

                if (selectedCount > 0) {
                    $('#btnExportExcelSelected').html(`<i class="bi bi-file-earmark-excel me-1"></i>Exportar (${selectedCount})`);
                } else {
                    $('#btnExportExcelSelected').html('<i class="bi bi-file-earmark-excel me-1"></i>Exportar seleccionadas');
                }
            }

            $('#selectAllOrdenes').on('change', function() {
                $('.orden-trabajo-checkbox').prop('checked', $(this).prop('checked'));
                updateExportButton();
            });

            $('.orden-trabajo-checkbox').on('change', function() {
                const total = $('.orden-trabajo-checkbox').length;
                const selected = $('.orden-trabajo-checkbox:checked').length;
                $('#selectAllOrdenes')
                    .prop('checked', total > 0 && selected === total)
                    .prop('indeterminate', selected > 0 && selected < total);
                updateExportButton();
            });

            $('#btnExportExcelSelected').on('click', function() {
                const selectedIds = $('.orden-trabajo-checkbox:checked').map(function() {
                    return $(this).val();
                }).get();

                if (selectedIds.length === 0) {
                    alert('Por favor seleccione al menos una orden de trabajo para exportar.');
                    return;
                }

                window.location.href = `/api/ordenes-trabajo/exportar-excel?ids=${encodeURIComponent(selectedIds.join(','))}`;
            });

            $('#btnExportExcelAll').on('click', function() {
                const params = new URLSearchParams(window.location.search);
                params.delete('page');
                params.delete('limit');
                const query = params.toString();
                window.location.href = `/api/ordenes-trabajo/exportar-excel${query ? '?' + query : ''}`;
            });
        });
    </script>
</body>
</html>

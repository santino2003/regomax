<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalle de Pago - Regomax</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom styles -->
    <link rel="stylesheet" href="/assets/css/home.css">
    <style>
        .info-card {
            transition: transform 0.2s;
        }
        .info-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        .badge-tipo-pago {
            font-size: 0.95rem;
            padding: 0.5rem 0.8rem;
        }
        .tipo-recepcion {
            background-color: #0d6efd;
        }
        .tipo-adelanto {
            background-color: #ffc107;
            color: #000;
        }
        .tipo-saldo {
            background-color: #198754;
        }
        .detail-label {
            font-weight: 600;
            color: #6c757d;
            margin-bottom: 0.25rem;
        }
        .detail-value {
            font-size: 1.1rem;
            color: #212529;
        }
        .monto-destacado {
            font-size: 1.5rem;
            font-weight: 700;
            color: #198754;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="/home">
                <img src="/assets/img/regomax.png" alt="Regomax Logo" class="bg-white rounded p-1">
                <span class="ms-2 fw-bold">Regomax S.A.</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item user-welcome me-3">
                        <span class="text-light">BIENVENIDO/A, <b><%= username %></b></span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#"><i class="bi bi-globe me-1"></i> Ver sitio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#" id="logout-link"><i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    
    <!-- Main Content -->
    <div class="container-fluid my-4">
        <div class="row">
            <div class="col-12">
                <div class="menu-container p-4">
                    <!-- Header -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="menu-heading mb-0">
                            <i class="bi bi-eye me-2"></i>Detalle del Pago #<%= pago.id %>
                        </h4>
                        <div>
                            <a href="/pagos/listar" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Volver al Listado
                            </a>
                        </div>
                    </div>

                    <div class="row g-4">
                        <!-- Información General -->
                        <div class="col-md-6">
                            <div class="card info-card border-primary h-100">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Información General</h5>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <div class="detail-label">ID de Pago</div>
                                        <div class="detail-value">#<%= pago.id %></div>
                                    </div>

                                    <div class="mb-3">
                                        <div class="detail-label">Orden de Compra</div>
                                        <div class="detail-value">
                                            <a href="/ordenes-compra/<%= pago.orden_compra_id %>" class="text-decoration-none">
                                                <i class="bi bi-box-seam me-1"></i><%= pago.orden_codigo %>
                                            </a>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <div class="detail-label">Proveedor</div>
                                        <div class="detail-value"><%= pago.proveedor_nombre %></div>
                                    </div>

                                    <div class="mb-3">
                                        <div class="detail-label">Tipo de Pago</div>
                                        <div class="detail-value">
                                            <% if (pago.tipo_pago === 'RECEPCION') { %>
                                                <span class="badge tipo-recepcion badge-tipo-pago">
                                                    <i class="bi bi-box-seam me-1"></i>Recepción
                                                </span>
                                            <% } else if (pago.tipo_pago === 'ADELANTO') { %>
                                                <span class="badge tipo-adelanto badge-tipo-pago">
                                                    <i class="bi bi-wallet2 me-1"></i>Adelanto
                                                </span>
                                            <% } else if (pago.tipo_pago === 'SALDO_COMPLETO') { %>
                                                <span class="badge tipo-saldo badge-tipo-pago">
                                                    <i class="bi bi-check-circle me-1"></i>Saldo Completo
                                                </span>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <div class="detail-label">Fecha de Pago</div>
                                        <div class="detail-value">
                                            <i class="bi bi-calendar-event me-1"></i>
                                            <%= new Date(pago.fecha_pago).toLocaleDateString('es-AR', { 
                                                year: 'numeric', 
                                                month: 'long', 
                                                day: 'numeric' 
                                            }) %>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <div class="detail-label">Fecha de Registro</div>
                                        <div class="detail-value text-muted">
                                            <i class="bi bi-clock me-1"></i>
                                            <%= new Date(pago.fecha_registro).toLocaleString('es-AR') %>
                                        </div>
                                    </div>

                                    <div class="mb-0">
                                        <div class="detail-label">Registrado Por</div>
                                        <div class="detail-value">
                                            <i class="bi bi-person me-1"></i><%= pago.registrado_por %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Información Financiera -->
                        <div class="col-md-6">
                            <div class="card info-card border-success h-100">
                                <div class="card-header bg-success text-white">
                                    <h5 class="mb-0"><i class="bi bi-cash-stack me-2"></i>Información Financiera</h5>
                                </div>
                                <div class="card-body">
                                    <div class="mb-4 text-center py-3 bg-light rounded">
                                        <div class="detail-label">Monto de Pago</div>
                                        <div class="monto-destacado">
                                            $<%= parseFloat(pago.monto_pago).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                        </div>
                                    </div>

                                    <% if (pago.monto_total) { %>
                                        <div class="mb-3">
                                            <div class="detail-label">Monto Total</div>
                                            <div class="detail-value">
                                                $<%= parseFloat(pago.monto_total).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                            </div>
                                        </div>
                                    <% } %>

                                    <% if (pago.monto_adelanto) { %>
                                        <div class="mb-3">
                                            <div class="detail-label">Monto Adelanto</div>
                                            <div class="detail-value">
                                                $<%= parseFloat(pago.monto_adelanto).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                            </div>
                                        </div>
                                    <% } %>

                                    <% if (pago.bien_nombre) { %>
                                        <hr>
                                        <h6 class="text-muted mb-3"><i class="bi bi-box me-1"></i>Información del Bien</h6>
                                        
                                        <div class="mb-3">
                                            <div class="detail-label">Bien</div>
                                            <div class="detail-value"><%= pago.bien_nombre %></div>
                                        </div>

                                        <% if (pago.bien_codigo) { %>
                                            <div class="mb-3">
                                                <div class="detail-label">Código</div>
                                                <div class="detail-value"><%= pago.bien_codigo %></div>
                                            </div>
                                        <% } %>

                                        <% if (pago.cantidad_recibida) { %>
                                            <div class="mb-3">
                                                <div class="detail-label">Cantidad Recibida</div>
                                                <div class="detail-value">
                                                    <%= parseFloat(pago.cantidad_recibida).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                                </div>
                                            </div>
                                        <% } %>

                                        <% if (pago.precio_unitario) { %>
                                            <div class="mb-0">
                                                <div class="detail-label">Precio Unitario</div>
                                                <div class="detail-value">
                                                    $<%= parseFloat(pago.precio_unitario).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                                </div>
                                            </div>
                                        <% } %>
                                    <% } else { %>
                                        <div class="alert alert-info mb-0" role="alert">
                                            <i class="bi bi-info-circle me-2"></i>
                                            No hay bien asociado a este pago
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <!-- Observaciones (si existen) -->
                        <% if (pago.observaciones) { %>
                            <div class="col-12">
                                <div class="card info-card border-info">
                                    <div class="card-header bg-info text-white">
                                        <h5 class="mb-0"><i class="bi bi-chat-left-text me-2"></i>Observaciones</h5>
                                    </div>
                                    <div class="card-body">
                                        <p class="mb-0 detail-value"><%= pago.observaciones %></p>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Logout script -->
    <script>
        document.getElementById('logout-link').addEventListener('click', function(e) {
            e.preventDefault();
            if (confirm('¿Está seguro que desea cerrar sesión?')) {
                fetch('/auth/logout', { 
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(() => {
                    window.location.href = '/login';
                })
                .catch(error => {
                    console.error('Error:', error);
                    window.location.href = '/login';
                });
            }
        });
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="es-AR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fallas - Regomax</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/assets/css/home.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="/home">
                <img src="/assets/img/regomax.png" alt="Regomax Logo" class="bg-white rounded p-1">
                <span class="ms-2 fw-bold">Regomax S.A.</span>
            </a>
            <div class="collapse navbar-collapse show">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item user-welcome me-3"><span class="text-light">BIENVENIDO/A, <b><%= username %></b></span></li>
                    <li class="nav-item"><a class="nav-link" href="#" id="logout-link"><i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container my-4">
        <div class="menu-container p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="menu-heading mb-0"><i class="bi bi-tools me-2"></i>Gestión de Fallas</h4>
                <a href="/fallas/nuevo" class="btn btn-primary"><i class="bi bi-plus-circle me-2"></i>Nueva Falla</a>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead><tr><th>Nombre</th><th>Responsable</th><th>Fecha Creación</th><th>Acciones</th></tr></thead>
                    <tbody>
                        <% if (fallas && fallas.length > 0) { %>
                            <% fallas.forEach((falla) => { %>
                                <tr>
                                    <td><%= falla.nombre %></td>
                                    <td><%= falla.responsable || '-' %></td>
                                    <td><%= falla.fecha_creacion ? new Date(falla.fecha_creacion).toLocaleDateString('es-AR') : '-' %></td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="/fallas/<%= falla.id %>" class="btn btn-sm btn-outline-primary" title="Ver"><i class="bi bi-eye"></i></a>
                                            <a href="/fallas/editar/<%= falla.id %>" class="btn btn-sm btn-outline-secondary" title="Editar"><i class="bi bi-pencil"></i></a>
                                            <button class="btn btn-sm btn-outline-danger btn-delete" data-id="<%= falla.id %>" data-nombre="<%= falla.nombre %>" title="Eliminar"><i class="bi bi-trash"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="4" class="text-center">No hay fallas registradas</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <% if (pagination && pagination.totalPages > 1) { %>
                <nav aria-label="Navegación de fallas"><ul class="pagination justify-content-center">
                    <li class="page-item <%= pagination.page === 1 ? 'disabled' : '' %>"><a class="page-link" href="/fallas?page=<%= pagination.page - 1 %>&limit=<%= pagination.limit %>">&laquo;</a></li>
                    <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                        <li class="page-item <%= pagination.page === i ? 'active' : '' %>"><a class="page-link" href="/fallas?page=<%= i %>&limit=<%= pagination.limit %>"><%= i %></a></li>
                    <% } %>
                    <li class="page-item <%= pagination.page === pagination.totalPages ? 'disabled' : '' %>"><a class="page-link" href="/fallas?page=<%= pagination.page + 1 %>&limit=<%= pagination.limit %>">&raquo;</a></li>
                </ul></nav>
            <% } %>

            <div class="d-flex justify-content-between align-items-center mt-3">
                <a href="/home" class="btn btn-secondary"><i class="bi bi-arrow-left me-2"></i>Volver al panel</a>
                <% if (pagination) { %><p class="text-muted mb-0">Total: <%= pagination.total %> fallas</p><% } %>
            </div>
        </div>
    </main>

    <div class="modal fade" id="deleteFallaModal" tabindex="-1">
        <div class="modal-dialog"><div class="modal-content">
            <div class="modal-header bg-danger text-white"><h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Eliminación</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
            <div class="modal-body"><p>¿Está seguro que desea eliminar la falla <strong id="deleteFallaNombre"></strong>?</p><p class="text-danger mb-0">¡Esta acción no se puede deshacer!</p></div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button><button type="button" class="btn btn-danger" id="confirmDelete">Eliminar</button></div>
        </div></div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/assets/js/common.js"></script>
    <script>
        $(document).ready(function() {
            let fallaId = null;
            const modal = new bootstrap.Modal(document.getElementById('deleteFallaModal'));
            $('.btn-delete').on('click', function() {
                fallaId = $(this).data('id');
                $('#deleteFallaNombre').text($(this).data('nombre'));
                modal.show();
            });
            $('#confirmDelete').on('click', async function() {
                if (!fallaId) return;
                const response = await fetch(`/api/fallas/${fallaId}`, { method: 'DELETE' });
                const data = await response.json();
                if (response.ok && data.success) window.location.reload();
                else alert(data.error || 'Error al eliminar la falla');
            });
        });
    </script>
</body>
</html>

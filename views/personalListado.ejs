<%- include('partials/header') %>
<script>document.body.dataset.allowBackNavigation = 'true';</script>
<div class="container my-4"><div class="menu-container p-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
        <h4 class="menu-heading mb-0"><i class="bi bi-people me-2" aria-hidden="true"></i>Personal</h4>
        <div><a href="/ingresos/personal" class="btn btn-outline-primary">Registrar ingreso</a> <a href="/personal/nuevo" class="btn btn-primary"><i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Nuevo personal</a></div>
    </div>
    <div id="alertPlaceholder" role="alert"></div>
    <label for="buscarPersonal" class="form-label">Buscar personal</label>
    <input id="buscarPersonal" class="form-control mb-3" placeholder="Nombre, apellido, patente, cargo o turno">
    <div class="table-responsive"><table class="table table-striped align-middle">
        <thead><tr><th>Nombre y apellido</th><th>Patente</th><th>Auto</th><th>Cargo</th><th>Turno</th><th>Estado</th><th>Acciones</th></tr></thead>
        <tbody>
            <% if (!personal.length) { %><tr><td colspan="7" class="text-center text-muted">No hay personal registrado.</td></tr><% } %>
            <% personal.forEach(p => { %>
                <tr data-personal-fila>
                    <td><%= p.nombre %> <%= p.apellido %></td><td><%= p.patente || '—' %></td><td><%= p.auto || '—' %></td><td><%= p.cargo || '—' %></td><td><%= p.turno || '—' %></td>
                    <td><span class="badge <%= Number(p.activo) ? 'bg-success' : 'bg-secondary' %>"><%= Number(p.activo) ? 'Activo' : 'Baja' %></span></td>
                    <td><div class="btn-group" role="group" aria-label="Acciones del personal <%= p.id %>">
                        <a href="/personal/<%= p.id %>" class="btn btn-sm btn-outline-primary" title="Ver detalles" aria-label="Ver ficha del personal <%= p.id %>"><i class="bi bi-eye" aria-hidden="true"></i></a>
                        <a href="/personal/<%= p.id %>/editar" class="btn btn-sm btn-outline-secondary" title="Editar personal" aria-label="Editar personal <%= p.id %>"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                        <% if (Number(p.activo)) { %>
                            <a href="/ingresos/personal?personal_id=<%= p.id %>" class="btn btn-sm btn-outline-primary" title="Registrar ingreso" aria-label="Registrar ingreso del personal <%= p.id %>"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i></a>
                            <button type="button" class="btn btn-sm btn-outline-danger" data-baja-personal="<%= p.id %>" data-nombre="<%= p.nombre %> <%= p.apellido %>" title="Dar de baja" aria-label="Dar de baja personal <%= p.id %>"><i class="bi bi-trash" aria-hidden="true"></i></button>
                        <% } %>
                    </div></td>
                </tr>
            <% }); %>
        </tbody>
    </table></div>
    <a href="/ingresos" class="btn btn-outline-secondary">Volver a ingresos</a>
</div></div>
<script src="/assets/js/personal.js"></script>
<%- include('partials/footer') %>

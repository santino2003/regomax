<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Máquinas - Regomax</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/assets/css/home.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="/home">
                <img src="/assets/img/regomax.png" alt="Regomax Logo" class="bg-white rounded p-1">
                <span class="ms-2 fw-bold">Regomax S.A.</span>
            </a>
            <div class="collapse navbar-collapse show">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item user-welcome me-3">
                        <span class="text-light">BIENVENIDO/A, <b><%= username %></b></span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#" id="logout-link"><i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container my-4">
        <div class="menu-container p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="menu-heading mb-0">
                    <i class="bi bi-gear-wide-connected me-2"></i>Gestión de Máquinas
                </h4>
                <a href="/maquinas/nuevo" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>Nueva Máquina
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Responsable</th>
                            <th>Fecha Creación</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (maquinas && maquinas.length > 0) { %>
                            <% maquinas.forEach(maquina => { %>
                                <tr>
                                    <td><%= maquina.nombre %></td>
                                    <td class="text-break"><%= maquina.descripcion || '-' %></td>
                                    <td><%= maquina.responsable || '-' %></td>
                                    <td><%= maquina.fecha_creacion ? new Date(maquina.fecha_creacion).toLocaleDateString('es-AR') : '-' %></td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="/maquinas/<%= maquina.id %>" class="btn btn-sm btn-outline-primary" title="Ver">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a href="/maquinas/editar/<%= maquina.id %>" class="btn btn-sm btn-outline-secondary" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button class="btn btn-sm btn-outline-danger btn-delete" data-id="<%= maquina.id %>" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center">No hay máquinas registradas</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <% if (pagination && pagination.totalPages > 1) { %>
                <nav aria-label="Navegación de máquinas">
                    <ul class="pagination justify-content-center">
                        <li class="page-item <%= pagination.page === 1 ? 'disabled' : '' %>">
                            <a class="page-link" href="/maquinas?page=<%= pagination.page - 1 %>&limit=<%= pagination.limit %>">&laquo;</a>
                        </li>
                        <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                            <li class="page-item <%= pagination.page === i ? 'active' : '' %>">
                                <a class="page-link" href="/maquinas?page=<%= i %>&limit=<%= pagination.limit %>"><%= i %></a>
                            </li>
                        <% } %>
                        <li class="page-item <%= pagination.page === pagination.totalPages ? 'disabled' : '' %>">
                            <a class="page-link" href="/maquinas?page=<%= pagination.page + 1 %>&limit=<%= pagination.limit %>">&raquo;</a>
                        </li>
                    </ul>
                </nav>
            <% } %>

            <div class="d-flex justify-content-between align-items-center mt-3">
                <a href="/home" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Volver al panel
                </a>
                <% if (pagination) { %>
                    <p class="text-muted mb-0">Total: <%= pagination.total %> máquinas</p>
                <% } %>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteMaquinaModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Eliminación</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>¿Está seguro que desea eliminar la máquina <span id="deleteMaquinaNombre" class="fw-bold"></span>?</p>
                    <p class="text-danger mb-0">¡Esta acción no se puede deshacer!</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger" id="confirmDelete">Eliminar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/assets/js/common.js"></script>
    <script>
        $(document).ready(function() {
            let maquinaIdToDelete = null;
            const deleteModal = new bootstrap.Modal(document.getElementById('deleteMaquinaModal'));

            $('.btn-delete').on('click', function() {
                maquinaIdToDelete = $(this).data('id');
                $('#deleteMaquinaNombre').text($(this).closest('tr').find('td:first').text());
                deleteModal.show();
            });

            $('#confirmDelete').on('click', function() {
                if (!maquinaIdToDelete) return;

                fetch(`/api/maquinas/${maquinaIdToDelete}`, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' }
                })
                .then(response => response.json())
                .then(() => {
                    deleteModal.hide();
                    window.location.reload();
                })
                .catch(error => {
                    console.error('Error:', error);
                    deleteModal.hide();
                    window.location.reload();
                });
            });
        });
    </script>
</body>
</html>

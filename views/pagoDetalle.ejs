<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalle de Pago - Regomax</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom styles -->
    <link rel="stylesheet" href="/assets/css/home.css">
    <style>
        @media print {
            @page {
                size: A4 portrait;
                margin: 10mm;
            }
            html,
            body {
                width: 100%;
                margin: 0 !important;
                padding: 0 !important;
                background: #fff !important;
            }
            body * {
                visibility: hidden;
            }
            .navbar,
            .menu-container > .d-flex,
            .menu-container > .row > .col-md-6,
            .menu-container > .row > .col-12:not(.mt-4),
            #reciboPago .btn {
                display: none !important;
            }
            .container-fluid,
            .container-fluid > .row,
            .container-fluid > .row > .col-12,
            .menu-container,
            .menu-container > .row,
            .menu-container > .row > .col-12.mt-4 {
                display: block !important;
                width: 100% !important;
                max-width: none !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            #reciboPago, #reciboPago * {
                visibility: visible;
            }
            #reciboPago {
                position: static;
                width: 100% !important;
                margin: 0 !important;
                border: 1px solid #000 !important;
                border-radius: .25rem !important;
                page-break-inside: avoid;
                break-inside: avoid;
                color: #000 !important;
                background: #fff !important;
                font-size: 12px !important;
            }
            #reciboPago .card-body {
                padding: 0.9rem !important;
            }
            #reciboPago .row {
                display: flex !important;
                flex-wrap: wrap !important;
            }
            #reciboPago .col-md-6 {
                flex: 0 0 auto !important;
                width: 50% !important;
                max-width: 50% !important;
            }
            #reciboPago .text-md-end {
                text-align: right !important;
            }
            #reciboPago .mt-md-0 {
                margin-top: 0 !important;
            }
            #reciboPago .monto-destacado {
                font-size: 1.35rem !important;
                color: #198754 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
            #reciboPago .proveedor-recibo {
                font-size: 1.35rem !important;
            }
            #reciboPago .firma-recibo {
                border-top: 2px solid #000 !important;
                min-height: 46px;
                padding-top: 0.5rem !important;
                margin-top: 2rem !important;
            }
        }
        #reciboPago {
            border: 1px solid #ced4da;
            border-radius: .25rem;
        }
        #reciboPago .firma-recibo {
            border-top: 1px solid #000;
            padding-top: 0.5rem;
            margin-top: 2.5rem;
        }
        .info-card {
            transition: transform 0.2s;
        }
        .info-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        .badge-tipo-pago {
            font-size: 0.95rem;
            padding: 0.5rem 0.8rem;
        }
        .tipo-recepcion {
            background-color: #0d6efd;
        }
        .tipo-adelanto {
            background-color: #ffc107;
            color: #000;
        }
        .tipo-saldo {
            background-color: #198754;
        }
        .detail-label {
            font-weight: 600;
            color: #6c757d;
            margin-bottom: 0.25rem;
        }
        .detail-value {
            font-size: 1.1rem;
            color: #212529;
        }
        .monto-destacado {
            font-size: 1.5rem;
            font-weight: 700;
            color: #198754;
        }
        .proveedor-recibo {
            font-size: 1.5rem;
            font-weight: 700;
            color: #212529;
        }
    </style>
</head>
<body data-allow-back-navigation="true" data-return-list-path="/pagos/listar">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="/home">
                <img src="/assets/img/regomax.png" alt="Regomax Logo" class="bg-white rounded p-1">
                <span class="ms-2 fw-bold">Regomax S.A.</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item user-welcome me-3">
                        <span class="text-light">BIENVENIDO/A, <b><%= username %></b></span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#"><i class="bi bi-globe me-1"></i> Ver sitio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#" id="logout-link"><i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    
    <!-- Main Content -->
    <div class="container-fluid my-4">
        <div class="row">
            <div class="col-12">
                <div class="menu-container p-4">
                    <!-- Header -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="menu-heading mb-0">
                            <i class="bi bi-eye me-2"></i>Detalle del Pago #<%= pago.id %>
                        </h4>
                        <div>
                            <a href="/pagos/listar" class="btn btn-secondary" data-return-to-list>
                                <i class="bi bi-arrow-left me-2"></i>Volver al Listado
                            </a>
                        </div>
                    </div>

                    <div class="row g-4">
                        <!-- Información General -->
                        <div class="col-md-6">
                            <div class="card info-card border-primary h-100">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Información General</h5>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <div class="detail-label">ID de Pago</div>
                                        <div class="detail-value">#<%= pago.id %></div>
                                    </div>

                                    <div class="mb-3">
                                        <div class="detail-label">Orden de Compra</div>
                                        <div class="detail-value">
                                            <% if (pago.orden_compra_id) { %>
                                                <a href="/ordenes-compra/<%= pago.orden_compra_id %>" class="text-decoration-none">
                                                    <i class="bi bi-box-seam me-1"></i><%= pago.orden_codigo %>
                                                </a>
                                            <% } else { %>
                                                <span class="text-muted">-</span>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <div class="detail-label">Proveedor</div>
                                        <div class="detail-value"><%= pago.proveedor_nombre || '-' %></div>
                                    </div>

                                    <div class="mb-3">
                                        <div class="detail-label">Tipo de Pago</div>
                                        <div class="detail-value">
                                            <% if (pago.tipo_pago === 'RECEPCION') { %>
                                                <span class="badge tipo-recepcion badge-tipo-pago">
                                                    <i class="bi bi-box-seam me-1"></i>Recepción
                                                </span>
                                            <% } else if (pago.tipo_pago === 'ADELANTO') { %>
                                                <span class="badge tipo-adelanto badge-tipo-pago">
                                                    <i class="bi bi-wallet2 me-1"></i>Adelanto
                                                </span>
                                            <% } else if (pago.tipo_pago === 'SALDO_COMPLETO') { %>
                                                <span class="badge tipo-saldo badge-tipo-pago">
                                                    <i class="bi bi-check-circle me-1"></i>Saldo Completo
                                                </span>
                                            <% } else if (pago.tipo_pago === 'MULTIPLE') { %>
                                                <span class="badge bg-secondary badge-tipo-pago">
                                                    <i class="bi bi-collection me-1"></i>Pago Múltiple
                                                </span>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <div class="detail-label">Fecha de Pago</div>
                                        <div class="detail-value">
                                            <i class="bi bi-calendar-event me-1"></i>
                                            <%= new Date(pago.fecha_pago).toLocaleDateString('es-AR', { 
                                                year: 'numeric', 
                                                month: 'long', 
                                                day: 'numeric' 
                                            }) %>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <div class="detail-label">Fecha de Registro</div>
                                        <div class="detail-value text-muted">
                                            <i class="bi bi-clock me-1"></i>
                                            <%= new Date(pago.fecha_registro).toLocaleString('es-AR') %>
                                        </div>
                                    </div>

                                    <div class="mb-0">
                                        <div class="detail-label">Registrado Por</div>
                                        <div class="detail-value">
                                            <i class="bi bi-person me-1"></i><%= pago.registrado_por %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Información Financiera -->
                        <div class="col-md-6">
                            <div class="card info-card border-success h-100">
                                <div class="card-header bg-success text-white">
                                    <h5 class="mb-0"><i class="bi bi-cash-stack me-2"></i>Información Financiera</h5>
                                </div>
                                <div class="card-body">
                                    <div class="mb-4 text-center py-3 bg-light rounded">
                                        <div class="detail-label">Monto de Pago</div>
                                        <div class="monto-destacado">
                                            <%= pago.moneda || 'ARS' %> <%= parseFloat(pago.monto_pago).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                        </div>
                                    </div>

                                    <% if (pago.monto_total) { %>
                                        <div class="mb-3">
                                            <div class="detail-label">Monto Total</div>
                                            <div class="detail-value">
                                                <%= pago.moneda || 'ARS' %> <%= parseFloat(pago.monto_total).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                            </div>
                                        </div>
                                    <% } %>

                                    <% if (pago.monto_adelanto) { %>
                                        <div class="mb-3">
                                            <div class="detail-label">Monto Adelanto</div>
                                            <div class="detail-value">
                                                <%= pago.moneda || 'ARS' %> <%= parseFloat(pago.monto_adelanto).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                            </div>
                                        </div>
                                    <% } %>

                                    <div class="mb-3">
                                        <div class="detail-label">Medio de Pago</div>
                                        <div class="detail-value"><%= pago.medio_pago || '-' %></div>
                                    </div>

                                    <% if (pago.bien_nombre) { %>
                                        <hr>
                                        <h6 class="text-muted mb-3"><i class="bi bi-box me-1"></i>Información del Bien</h6>
                                        
                                        <div class="mb-3">
                                            <div class="detail-label">Bien</div>
                                            <div class="detail-value"><%= pago.bien_nombre %></div>
                                        </div>

                                        <% if (pago.bien_codigo) { %>
                                            <div class="mb-3">
                                                <div class="detail-label">Código</div>
                                                <div class="detail-value"><%= pago.bien_codigo %></div>
                                            </div>
                                        <% } %>

                                        <% if (pago.cantidad_recibida) { %>
                                            <div class="mb-3">
                                                <div class="detail-label">Cantidad Recibida</div>
                                                <div class="detail-value">
                                                    <%= parseFloat(pago.cantidad_recibida).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                                </div>
                                            </div>
                                        <% } %>

                                        <% if (pago.precio_unitario) { %>
                                            <div class="mb-0">
                                                <div class="detail-label">Precio Unitario</div>
                                                <div class="detail-value">
                                                    $<%= parseFloat(pago.precio_unitario).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                                </div>
                                            </div>
                                        <% } %>
                                    <% } else { %>
                                        <div class="alert alert-info mb-0" role="alert">
                                            <i class="bi bi-info-circle me-2"></i>
                                            No hay bien asociado a este pago
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <!-- Observaciones (si existen) -->
                        <% if (pago.observaciones) { %>
                            <div class="col-12">
                                <div class="card info-card border-info">
                                    <div class="card-header bg-info text-white">
                                        <h5 class="mb-0"><i class="bi bi-chat-left-text me-2"></i>Observaciones</h5>
                                    </div>
                                    <div class="card-body">
                                        <p class="mb-0 detail-value"><%= pago.observaciones %></p>
                                    </div>
                                </div>
                            </div>
                        <% } %>

                        <!-- Detalle del Pago (si fue marcado como pagado) -->
                        <% if (pago.pagado && pago.detalle_pago) { %>
                            <div class="col-12">
                                <div class="card info-card border-success">
                                    <div class="card-header bg-success text-white">
                                        <h5 class="mb-0">
                                            <i class="bi bi-check-circle me-2"></i>Detalle del Pago
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-2">
                                            <span class="detail-label">Marcado como pagado por:</span>
                                            <span class="detail-value"><%= pago.marcado_pagado_por || 'N/A' %></span>
                                        </div>
                                        <div class="mb-2">
                                            <span class="detail-label">Fecha:</span>
                                            <span class="detail-value">
                                                <%= pago.fecha_marcado_pagado ? new Date(pago.fecha_marcado_pagado).toLocaleString('es-AR') : 'N/A' %>
                                            </span>
                                        </div>
                                        <hr>
                                        <div>
                                            <span class="detail-label">Detalle:</span>
                                            <p class="mb-0 detail-value mt-2"><%- (pago.detalle_pago || '').replace(/\n/g, '<br>') %></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% } %>

                        <!-- Recibo imprimible para firma (solo si está pagado) -->
                        <% if (pago.pagado) { %>
                            <div class="col-12 mt-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h5 class="mb-0"><i class="bi bi-receipt me-2"></i>Recibo de Pago</h5>
                                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="window.print()">
                                        <i class="bi bi-printer me-1"></i>Imprimir recibo
                                    </button>
                                </div>

                                <div class="card border-dark" id="reciboPago">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <p class="proveedor-recibo mb-1"><%= pago.proveedor_nombre %></p>
                                                <p class="mb-1">Recibo de Pago</p>
                                                <p class="mb-0"><small>Fecha: <%= new Date(pago.fecha_marcado_pagado || pago.fecha_pago).toLocaleDateString('es-AR') %></small></p>
                                            </div>
                                            <div class="col-md-6 text-md-end mt-3 mt-md-0">
                                                <p class="mb-1"><small>ID de Pago: #<%= pago.id %></small></p>
                                                <p class="mb-1"><small>Orden de Compra: <%= pago.orden_codigo %></small></p>
                                            </div>
                                        </div>

                                        <hr>

                                        <p>He recibido la suma de:</p>
                                        <p class="monto-destacado mb-1">
                                            <%= pago.moneda || 'ARS' %> <%= parseFloat(pago.monto_pago).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                        </p>
                                        <p class="mb-3">
                                            <% if (pago.tipo_pago === 'RECEPCION') { %>
                                                en concepto de pago por recepción de bienes vinculados a la Orden de Compra <strong><%= pago.orden_codigo %></strong>.
                                            <% } else if (pago.tipo_pago === 'ADELANTO') { %>
                                                en concepto de <strong>adelanto</strong> correspondiente a la Orden de Compra <strong><%= pago.orden_codigo %></strong>.
                                            <% } else if (pago.tipo_pago === 'SALDO_COMPLETO') { %>
                                                en concepto de <strong>saldo completo</strong> de la Orden de Compra <strong><%= pago.orden_codigo %></strong>.
                                            <% } else if (pago.tipo_pago === 'MULTIPLE') { %>
                                                en concepto de <strong>pago múltiple</strong> con comprobante único.
                                            <% } else { %>
                                                en concepto de pago correspondiente a la Orden de Compra <strong><%= pago.orden_codigo %></strong>.
                                            <% } %>
                                        </p>

                                        <% if (pago.detalle_pago) { %>
                                            <p class="mb-3"><strong>Detalle / Observaciones:</strong> <%- (pago.detalle_pago || '').replace(/\n/g, '<br>') %></p>
                                        <% } else if (pago.observaciones) { %>
                                            <p class="mb-3"><strong>Detalle / Observaciones:</strong> <%- (pago.observaciones || '').replace(/\n/g, '<br>') %></p>
                                        <% } %>

                                        <div class="row mt-4">
                                            <div class="col-md-6 text-center">
                                                <div class="firma-recibo">
                                                    <strong>Firma y Aclaración</strong><br>
                                                    <small>Proveedor / Responsable</small>
                                                </div>
                                            </div>
                                            <div class="col-md-6 text-center mt-4 mt-md-0">
                                                <div class="firma-recibo">
                                                    <strong>Aclaración</strong><br>
                                                    <small>Documento</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/js/common.js"></script>
    
    <!-- Logout script -->
    <script>
        document.getElementById('logout-link').addEventListener('click', function(e) {
            e.preventDefault();
            if (confirm('¿Está seguro que desea cerrar sesión?')) {
                fetch('/auth/logout', { 
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(() => {
                    window.location.href = '/login';
                })
                .catch(error => {
                    console.error('Error:', error);
                    window.location.href = '/login';
                });
            }
        });
    </script>
</body>
</html>

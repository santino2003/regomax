<%- include('partials/header') %>
<script>document.body.dataset.allowBackNavigation = 'true';</script>
<div class="container my-4"><div class="menu-container p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><h4 class="menu-heading mb-0">Empresas de ingresos</h4><button type="button" class="btn btn-primary" data-empresa-nueva><i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Nueva empresa</button></div>
    <p class="text-muted">Empresas para Basura, Acero, Proveedor y Visita.</p>
    <div id="errorListadoEmpresas" class="alert alert-danger d-none" role="alert"></div>
    <label for="buscarEmpresaIngreso" class="form-label">Buscar empresa</label><input id="buscarEmpresaIngreso" class="form-control mb-3" type="search" placeholder="Nombre o descripción">
    <div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Empresa</th><th>Descripción</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
        <% if (!empresas.length) { %><tr><td colspan="4" class="text-center text-muted">No hay empresas registradas.</td></tr><% } %>
        <% empresas.forEach(empresa => { %><tr data-fila-empresa>
            <td><%= empresa.nombre %></td><td style="white-space: pre-wrap;"><%= empresa.descripcion || '—' %></td>
            <td><span class="badge <%= Number(empresa.activo) ? 'bg-success' : 'bg-secondary' %>"><%= Number(empresa.activo) ? 'Activa' : 'Baja' %></span></td>
            <td><div class="btn-group" role="group" aria-label="Acciones de la empresa <%= empresa.id %>">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-empresa-editar="<%= empresa.id %>" data-nombre="<%= empresa.nombre %>" data-descripcion="<%= empresa.descripcion || '' %>" data-activo="<%= empresa.activo %>" title="Editar empresa" aria-label="Editar empresa <%= empresa.id %>"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                <% if (Number(empresa.activo)) { %><button type="button" class="btn btn-sm btn-outline-danger" data-empresa-baja="<%= empresa.id %>" data-nombre="<%= empresa.nombre %>" title="Dar de baja" aria-label="Dar de baja empresa <%= empresa.id %>"><i class="bi bi-trash" aria-hidden="true"></i></button><% } %>
            </div></td>
        </tr><% }); %>
    </tbody></table></div>
    <a href="/ingresos" class="btn btn-outline-secondary">Volver a ingresos</a>
</div></div>
<%- include('partials/empresaIngresoModal') %>
<script src="/assets/js/empresasIngresos.js"></script>
<%- include('partials/footer') %>

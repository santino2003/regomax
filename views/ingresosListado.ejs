<%- include('partials/header') %>
<div class="container my-4">
    <div class="menu-container p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <h4 class="menu-heading mb-0">Ingresos y egresos</h4>
            <a href="/ingresos" class="btn btn-primary"><i class="bi bi-plus-circle me-2"></i>Registrar ingreso</a>
        </div>
        <% if (registrado) { %>
            <div class="alert alert-success" role="status">Ingreso registrado correctamente.</div>
        <% } %>
        <% if (egresoRegistrado) { %>
            <div class="alert alert-success" role="status">Egreso registrado correctamente.</div>
        <% } %>
        <% if (errorListado) { %>
            <div class="alert alert-danger" role="alert">No se pudo cargar el listado. <a href="/ingresos/listado">Reintentar</a></div>
        <% } else { %>
            <p class="text-muted">Total de movimientos: <%= total %></p>
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead><tr>
                        <th scope="col">ID</th><th scope="col">Fecha y hora</th><th scope="col">Movimiento</th>
                        <th scope="col">Motivo</th><th scope="col">Nombre y apellido</th><th scope="col">Patente</th>
                        <th scope="col">Empresa</th><th scope="col">Egreso</th><th scope="col">Acciones</th>
                    </tr></thead>
                    <tbody>
                        <% if (!movimientos.length) { %>
                            <tr><td colspan="9" class="text-center text-muted">No hay ingresos ni egresos registrados.</td></tr>
                        <% } %>
                        <% movimientos.forEach(movimiento => { %>
                            <tr>
                                <td><%= movimiento.id %></td>
                                <td><%= fechaUtils.formatearFechaHoraLocal(movimiento.fecha_movimiento) %></td>
                                <td><%= movimiento.tipo_movimiento %></td>
                                <td><%= movimiento.motivo %></td>
                                <td><%= movimiento.nombre %> <%= movimiento.apellido %></td>
                                <td><%= movimiento.patente || '—' %></td>
                                <td><%= movimiento.empresa || '—' %></td>
                                <td>
                                    <% if (movimiento.tipo_movimiento === 'INGRESO') { %>
                                        <% if (movimiento.egreso_id) { %>
                                            <span class="badge bg-secondary">Egresado</span>
                                            <div class="small text-muted"><%= fechaUtils.formatearFechaHoraLocal(movimiento.fecha_egreso) %></div>
                                        <% } else { %>
                                            <span class="badge bg-warning text-dark">Sin egreso vinculado</span>
                                        <% } %>
                                    <% } else { %>
                                        <span class="badge bg-secondary">Salida registrada</span>
                                    <% } %>
                                </td>
                                <td>
                                    <div class="btn-group" role="group" aria-label="Acciones del movimiento <%= movimiento.id %>">
                                    <a href="/ingresos/<%= movimiento.id %>/detalle?page=<%= pagina %>" class="btn btn-sm btn-outline-primary" title="Ver detalles"
                                        aria-label="Ver detalles del movimiento <%= movimiento.id %>"><i class="bi bi-eye" aria-hidden="true"></i></a>
                                    <% if (movimiento.tipo_movimiento === 'INGRESO' && !movimiento.egreso_id) { %>
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Dar egreso" data-dar-egreso
                                            data-ingreso-id="<%= movimiento.id %>"
                                            data-persona="<%= movimiento.nombre %> <%= movimiento.apellido %>"
                                            data-patente="<%= movimiento.patente || '—' %>"
                                            data-empresa="<%= movimiento.empresa || '—' %>"
                                            data-fecha="<%= fechaUtils.formatearFechaHoraLocal(movimiento.fecha_movimiento) %>"
                                            aria-label="Dar egreso al ingreso <%= movimiento.id %>">
                                            <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                        </button>
                                    <% } %>
                                    <% if (movimiento.tipo_movimiento === 'INGRESO') { %>
                                        <a href="/ingresos/<%= movimiento.id %>/editar?page=<%= pagina %>" class="btn btn-sm btn-outline-secondary" title="Editar ingreso" aria-label="Editar ingreso <%= movimiento.id %>"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                    <% } %>
                                    </div>
                                    <% if (movimiento.ingreso_id) { %>
                                        <span class="small text-muted d-block mt-1">Ingreso #<%= movimiento.ingreso_id %></span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <% if (paginas > 1) { %>
                <nav aria-label="Paginación de movimientos" class="d-flex align-items-center gap-3 my-3">
                    <% if (pagina > 1) { %><a class="btn btn-outline-primary" href="/ingresos/listado?page=<%= pagina - 1 %>">Anterior</a><% } %>
                    <span>Página <%= pagina %> de <%= paginas %></span>
                    <% if (pagina < paginas) { %><a class="btn btn-outline-primary" href="/ingresos/listado?page=<%= pagina + 1 %>">Siguiente</a><% } %>
                </nav>
            <% } %>
        <% } %>
        <a href="/home" class="btn btn-outline-secondary mt-3">Volver al inicio</a>
    </div>
</div>
<div class="modal fade" id="modalEgreso" tabindex="-1" aria-labelledby="tituloEgreso" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tituloEgreso">Confirmar egreso</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div id="errorEgreso" class="alert alert-danger d-none" role="alert"></div>
                <p>Verifique los datos antes de registrar la salida.</p>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Ingreso</dt><dd class="col-sm-8" id="egresoIngreso"></dd>
                    <dt class="col-sm-4">Persona</dt><dd class="col-sm-8" id="egresoPersona"></dd>
                    <dt class="col-sm-4">Patente</dt><dd class="col-sm-8" id="egresoPatente"></dd>
                    <dt class="col-sm-4">Empresa</dt><dd class="col-sm-8" id="egresoEmpresa"></dd>
                    <dt class="col-sm-4">Fecha de ingreso</dt><dd class="col-sm-8" id="egresoFecha"></dd>
                </dl>
                <p class="small text-muted mb-0">La salida se registrará con la fecha y hora actuales.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="confirmarEgreso">Confirmar egreso</button>
            </div>
        </div>
    </div>
</div>
<script src="/assets/js/ingresosListado.js?v=egresos-1"></script>
<%- include('partials/footer') %>

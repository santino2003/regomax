<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ingresos - Regomax</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/home.css">
</head>
<body data-allow-back-navigation="true">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="/home">
                <img src="/assets/img/regomax.png" alt="Regomax Logo" class="bg-white rounded p-1">
                <span class="ms-2 fw-bold">Regomax S.A.</span>
            </a>
            <div class="collapse navbar-collapse show">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item user-welcome me-3">
                        <span class="text-light">BIENVENIDO/A, <b><%= username %></b></span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#" id="logout-link"><i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container my-4">
        <div class="menu-container p-4">
            <h4 class="menu-heading mb-4"><i class="bi bi-person-vcard me-2"></i>Ingresos</h4>
            <div id="alertPlaceholder" role="status" aria-live="polite"></div>

            <form id="formIdentificar" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="entrada" class="form-label">DNI o escaneo del documento <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="entrada" name="entrada" maxlength="1000" autocomplete="off" autofocus required aria-describedby="ayudaDni">
                    <div id="ayudaDni" class="form-text">Escanee el DNI o ingrese el número sin puntos y presione Enter o Continuar.</div>
                    <div class="invalid-feedback">Ingrese el DNI o escanee el documento.</div>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-arrow-right me-2"></i>Continuar</button>
                <a href="/home" class="btn btn-outline-secondary ms-2">Volver</a>
            </form>

            <form id="formPersona" class="needs-validation d-none" novalidate>
                <p class="text-muted">La persona no está registrada. Complete sus datos para continuar.</p>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label for="nombre" class="form-label">Nombre <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="nombre" name="nombre" maxlength="100" required>
                        <div class="invalid-feedback">Ingrese el nombre.</div>
                    </div>
                    <div class="col-md-6">
                        <label for="apellido" class="form-label">Apellido <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="apellido" name="apellido" maxlength="100" required>
                        <div class="invalid-feedback">Ingrese el apellido.</div>
                    </div>
                    <div class="col-md-6">
                        <label for="dni" class="form-label">DNI <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="dni" name="dni" readonly required>
                    </div>
                    <div class="col-md-6">
                        <label for="sexo" class="form-label">Sexo <span class="text-danger">*</span></label>
                        <select class="form-select" id="sexo" name="sexo" required>
                            <option value="">Seleccione...</option>
                            <option value="M">Masculino</option>
                            <option value="F">Femenino</option>
                            <option value="X">X</option>
                        </select>
                        <div class="invalid-feedback">Seleccione el sexo.</div>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-2"></i>Registrar y continuar</button>
                <button type="button" class="btn btn-outline-secondary ms-2" data-reiniciar>Cambiar DNI</button>
            </form>

            <div id="personaSeleccionada" class="d-none">
                <div class="alert alert-success" role="status">Persona identificada correctamente.</div>
                <dl class="row mb-3">
                    <dt class="col-sm-3">Nombre</dt><dd class="col-sm-9" id="personaNombre"></dd>
                    <dt class="col-sm-3">Apellido</dt><dd class="col-sm-9" id="personaApellido"></dd>
                    <dt class="col-sm-3">DNI</dt><dd class="col-sm-9" id="personaDni"></dd>
                    <dt class="col-sm-3">Sexo</dt><dd class="col-sm-9" id="personaSexo"></dd>
                </dl>
                <form id="formMotivoIngreso" class="needs-validation mb-4" novalidate>
                    <div class="mb-3">
                        <label for="motivoIngreso" class="form-label">Motivo de ingreso <span class="text-danger">*</span></label>
                        <select class="form-select" id="motivoIngreso" name="motivo" required aria-controls="camposNFU">
                            <option value="">Seleccione un motivo</option>
                            <option value="CNFU/NFU">CNFU/NFU</option>
                        </select>
                    </div>
                    <fieldset id="camposNFU" class="d-none" disabled>
                        <legend class="fs-6">Datos del ingreso CNFU/NFU</legend>
                        <% if (errorClientes) { %>
                            <div class="alert alert-warning" role="alert">No se pudieron cargar las empresas. Recargue la página para intentar nuevamente.</div>
                        <% } else if (!clientes.length) { %>
                            <div class="alert alert-info">No hay clientes NFU registrados.</div>
                        <% } %>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="cliente_id" class="form-label">Empresa <span class="text-danger">*</span></label>
                                <select class="form-select" id="cliente_id" name="cliente_id" required aria-describedby="ayudaEmpresa">
                                    <option value="">Seleccionar cliente</option>
                                    <% clientes.forEach(cliente => { %>
                                        <option value="<%= cliente.id %>"><%= cliente.empresa %> - <%= cliente.cuit %></option>
                                    <% }); %>
                                </select>
                                <div id="ayudaEmpresa" class="form-text">Busque escribiendo el nombre o CUIT del cliente NFU.</div>
                            </div>
                            <div class="col-md-6">
                                <label for="tipo" class="form-label">Tipo <span class="text-danger">*</span></label>
                                <select class="form-select" id="tipo" name="tipo" required>
                                    <option value="">Seleccionar tipo</option>
                                    <option value="Auto">Auto</option>
                                    <option value="Camion">Camión</option>
                                    <option value="Mix">Mix</option>
                                    <option value="Otros">Otros</option>
                                </select>
                            </div>
                        </div>
                        <div class="mt-3">
                            <label for="patente" class="form-label">Patente del vehículo <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="patente" name="patente" maxlength="20" required placeholder="Ej.: AB123CD o ABC123" autocapitalize="characters" spellcheck="false">
                        </div>
                    </fieldset>
                    <button type="submit" class="btn btn-primary mt-3"><i class="bi bi-save me-2"></i>Guardar ingreso</button>
                </form>
                <button type="button" class="btn btn-outline-secondary" data-reiniciar>Ingresar otro DNI</button>
                <a href="/home" class="btn btn-outline-secondary ms-2">Volver</a>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="/assets/js/common.js"></script>
    <script src="/assets/js/ingresosNuevo.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nueva Orden de Compra - Regomax</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/assets/css/home.css">
    <style>
        .item-row {
            background-color: #f8f9fa;
            padding: 15px;
            margin-bottom: 10px;
            border-radius: 5px;
            border: 1px solid #dee2e6;
        }
        .btn-remove-item {
            position: absolute;
            top: 10px;
            right: 10px;
        }
        .sticky-top {
            position: sticky;
            top: 0;
            z-index: 10;
        }
        [id^="tablaCuotasOC_"] input {
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="/home">
                <img src="/assets/img/regomax.png" alt="Regomax Logo" class="bg-white rounded p-1">
                <span class="ms-2 fw-bold">Regomax S.A.</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item user-welcome me-3">
                        <span class="text-light">BIENVENIDO/A, <b><%= username %></b></span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#"><i class="bi bi-globe me-1"></i> Ver sitio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#" id="logout-link"><i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container my-4">
        <div class="row mb-4">
            <div class="col">
                <div class="menu-container p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="menu-heading mb-0">
                            <i class="bi bi-plus-circle me-2"></i>Nueva Orden de Compra
                        </h4>
                        <a href="/ordenes-compra" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Volver
                        </a>
                    </div>
                    
                    <div id="alertPlaceholder"></div>
                    
                    <form id="formNuevaOrden" class="needs-validation" novalidate>
                        <!-- Información General -->
                        <div class="card mb-3 shadow-sm">
                            <div class="card-header" style="background-color: #17a2b8; color: white;">
                                <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Información General</h5>
                            </div>
                            <div class="card-body bg-light">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label for="condicion" class="form-label">Condición <span class="text-danger">*</span></label>
                                        <select class="form-select" id="condicion" name="condicion" required>
                                            <option value="">Seleccionar...</option>
                                            <option value="No Critica">No Crítica</option>
                                            <option value="Semi Critica">Semi Crítica</option>
                                            <option value="Muy Critica">Muy Crítica</option>
                                        </select>
                                        <div class="invalid-feedback">La condición es obligatoria</div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-check mt-4">
                                            <input class="form-check-input" type="checkbox" id="contrafactura" name="contrafactura" value="true">
                                            <label class="form-check-label" for="contrafactura">
                                                <i class="bi bi-receipt me-1"></i>Es a Contrafactura
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <!-- Fecha de Pago y Cuotas (solo visible si es contrafactura) -->
                                <div id="contrafacturaContainer" style="display: none;">
                                    <!-- Sección de Cuotas por Moneda -->
                                    <div id="planesCuotasContainer"></div>
                                </div>
                                
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label for="fecha_entrega_solicitada" class="form-label">Fecha de Entrega Solicitada</label>
                                        <input type="date" class="form-control" id="fecha_entrega_solicitada" name="fecha_entrega_solicitada">
                                    </div>
                                    <div class="col-md-6">
                                        <label for="fecha_entrega_proveedor" class="form-label">Fecha de Entrega Proveedor</label>
                                        <input type="date" class="form-control" id="fecha_entrega_proveedor" name="fecha_entrega_proveedor">
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-12">
                                        <label for="asunto" class="form-label">Asunto</label>
                                        <textarea class="form-control" id="asunto" name="asunto" rows="3"></textarea>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-12">
                                        <label class="form-label">Archivos Adjuntos</label>
                                        <div class="d-flex gap-2 mb-2">
                                            <button type="button" class="btn btn-sm btn-outline-primary" id="btnAgregarArchivo">
                                                <i class="bi bi-paperclip me-1"></i>Agregar Archivo(s)
                                            </button>
                                        </div>
                                        <input type="file" class="d-none" id="archivoInput" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.dwg">
                                        <div id="listaArchivos" class="border rounded p-2 bg-light" style="min-height: 50px;">
                                            <small class="text-muted">No hay archivos seleccionados</small>
                                        </div>
                                        <small class="text-muted">Formatos permitidos: PDF, Word, Excel, Imágenes, DWG (máx. 10MB por archivo).</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Items de la Orden -->
                        <div class="card mb-3 shadow-sm">
                            <div class="card-header" style="background-color: #5bc0de; color: white;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>ITEMS</h5>
                                    <button type="button" class="btn btn-light btn-sm" id="btnAgregarItem">
                                        <i class="bi bi-plus-circle me-1"></i>Agregar otro/a Item
                                    </button>
                                </div>
                            </div>
                            <div class="card-body bg-light" id="itemsContainer">
                                <!-- Los items se agregarán dinámicamente aquí -->
                            </div>
                        </div>

                        <div class="card mb-3 shadow-sm" id="ajustesTotalContainer" style="display: none;">
                            <div class="card-header bg-secondary text-white">
                                <h5 class="mb-0"><i class="bi bi-calculator me-2"></i>Ajustes del Total</h5>
                            </div>
                            <div class="card-body bg-light">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label for="impuestos" class="form-label">Impuestos</label>
                                        <input type="number" class="form-control ajuste-total" id="impuestos" name="impuestos" step="0.01" min="0" placeholder="0.00">
                                    </div>
                                    <div class="col-md-6">
                                        <label for="descuento" class="form-label">Descuento</label>
                                        <input type="number" class="form-control ajuste-total" id="descuento" name="descuento" step="0.01" min="0" placeholder="0.00">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a href="/ordenes-compra" class="btn btn-secondary">
                                <i class="bi bi-x-circle me-1"></i>Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary" id="btnGuardar">
                                <i class="bi bi-save me-1"></i>Guardar Orden de Compra
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        const token = localStorage.getItem('token');
        // Datos cargados desde el servidor (EJS)
        let bienes = <%- JSON.stringify(bienes) %>;
        let unidadesMedida = <%- JSON.stringify(unidadesMedida) %>;
        let centrosCosto = <%- JSON.stringify(centrosCosto) %>;
        let itemCounter = 0;
        let archivosSeleccionados = []; // Array para guardar los archivos
        let preciosBienes = {}; // Almacena los precios de los bienes seleccionados

        $(document).ready(function() {
            agregarItemVacio();

            $('#btnAgregarItem').on('click', agregarItemVacio);
            
            // Manejar el checkbox de contrafactura para mostrar/ocultar sección de cuotas
            $('#contrafactura').on('change', function() {
                const isChecked = $(this).is(':checked');
                const $contrafacturaContainer = $('#contrafacturaContainer');
                
                if (isChecked) {
                    $contrafacturaContainer.slideDown();
                    $('#ajustesTotalContainer').slideDown();
                    reconstruirPlanesCuotasPorMoneda();
                } else {
                    $contrafacturaContainer.slideUp();
                    $('#ajustesTotalContainer').slideUp();
                    $('#impuestos, #descuento').val('');
                    $('#planesCuotasContainer').empty();
                }
            });

            $('#planesCuotasContainer').on('change', '.cantidad-cuotas-moneda', function() {
                const moneda = $(this).data('moneda');
                generarCuotasMoneda(moneda);
            });

            $('#planesCuotasContainer').on('input change', '.monto-cuota-moneda', function() {
                const moneda = $(this).data('moneda');
                actualizarTotalesCuotasMoneda(moneda);
            });

            $('#planesCuotasContainer').on('change', '.adelanto-moneda, .fecha-adelanto-moneda', function() {
                reconstruirPlanesCuotasPorMoneda();
            });

            $('.ajuste-total').on('input change', calcularMontoTotal);
            
            // Manejar el botón de agregar archivo
            $('#btnAgregarArchivo').on('click', function() {
                $('#archivoInput').click();
            });

            // Manejar la selección de archivos
            $('#archivoInput').on('change', function(e) {
                const nuevosArchivos = Array.from(e.target.files);
                
                // Validar tamaño (10MB por archivo)
                for (const archivo of nuevosArchivos) {
                    if (archivo.size > 10 * 1024 * 1024) {
                        mostrarAlerta(`El archivo "${archivo.name}" excede el tamaño máximo de 10MB`, 'warning');
                        continue;
                    }
                    
                    // Verificar si el archivo ya fue agregado
                    const yaExiste = archivosSeleccionados.some(a => a.name === archivo.name && a.size === archivo.size);
                    if (!yaExiste) {
                        archivosSeleccionados.push(archivo);
                    }
                }
                
                actualizarListaArchivos();
                // Limpiar el input para poder seleccionar el mismo archivo nuevamente
                e.target.value = '';
            });
            
            $('#formNuevaOrden').on('submit', function(e) {
                e.preventDefault();
                if (this.checkValidity()) {
                    guardarOrden();
                }
                this.classList.add('was-validated');
            });

            $('#logout-link').on('click', function(e) {
                e.preventDefault();
                localStorage.removeItem('token');
                window.location.href = '/login.html';
            });
        });

        function agregarItemVacio() {
            itemCounter++;
            const itemHtml = `
                <div class="item-row position-relative" data-item="${itemCounter}">
                    <button type="button" class="btn btn-danger btn-sm btn-remove-item" onclick="eliminarItem(${itemCounter})">
                        <i class="bi bi-x-lg"></i> ¿ELIMINAR?
                    </button>
                    
                    <div class="row mb-2">
                        <div class="col-md-6">
                            <label class="form-label">BIEN <span class="text-danger">*</span></label>
                            <select class="form-select select2-bien" name="items[${itemCounter}][bien_id]" required>
                                <option value="">---------</option>
                                ${bienes.map(b => `<option value="${b.id}">${b.codigo} - ${b.nombre}</option>`).join('')}
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">CENTRO COSTO</label>
                            <select class="form-select" name="items[${itemCounter}][centro_costo]">
                                <option value="">---------</option>
                                ${centrosCosto.map(cc => `<option value="${cc.nombre}">${cc.nombre}</option>`).join('')}
                            </select>
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-12">
                            <label class="form-label">DESCRIPCIÓN</label>
                            <textarea class="form-control" name="items[${itemCounter}][descripcion]" rows="2"></textarea>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-2 col-lg-2">
                            <label class="form-label">CANTIDAD <span class="text-danger">*</span></label>
                            <input type="number" class="form-control item-cantidad" name="items[${itemCounter}][cantidad]" step="0.01" required data-item="${itemCounter}">
                        </div>
                        <div class="col-md-3 col-lg-2">
                            <label class="form-label">UNIDAD DE MEDIDA</label>
                            <select class="form-select" name="items[${itemCounter}][unidad_medida_id]">
                                <option value="">---------</option>
                                ${unidadesMedida.map(um => `<option value="${um.id}">${um.nombre}</option>`).join('')}
                            </select>
                        </div>
                        <div class="col-md-3 col-lg-2">
                            <label class="form-label">PRECIO UNITARIO</label>
                            <input type="number" class="form-control item-precio" name="items[${itemCounter}][precio_unitario]" step="0.01" min="0" placeholder="0.00" data-item="${itemCounter}" readonly>
                        </div>
                        <div class="col-md-2 col-lg-1">
                            <label class="form-label">MONEDA</label>
                            <input type="text" class="form-control item-moneda" value="" placeholder="---" readonly>
                        </div>
                        <div class="col-md-4 col-lg-2">
                            <label class="form-label">MEDIO PAGO <span class="text-danger">*</span></label>
                            <select class="form-select" name="items[${itemCounter}][medio_pago]" required>
                                <option value="">---------</option>
                                <option value="Efectivo">Efectivo</option>
                                <option value="Transferencia">Transferencia</option>
                            </select>
                            <div class="invalid-feedback">El medio de pago es obligatorio</div>
                        </div>
                        <div class="col-md-8 col-lg-3">
                            <label class="form-label">PROVEEDOR <span class="text-danger">*</span></label>
                            <select class="form-select" name="items[${itemCounter}][proveedor_sugerido_id]" required>
                                <option value="">Seleccione un bien primero</option>
                            </select>
                            <div class="invalid-feedback">El proveedor es obligatorio</div>
                        </div>
                    </div>
                </div>
            `;
            
            $('#itemsContainer').append(itemHtml);
            
            // Inicializar Select2 para el nuevo item
            $(`[data-item="${itemCounter}"] .select2-bien`).select2({
                theme: 'bootstrap-5',
                width: '100%',
                placeholder: 'Buscar bien...'
            });

            // Event listener para cargar proveedores cuando se selecciona un bien
            $(`[data-item="${itemCounter}"] .select2-bien`).on('change', function() {
                const bienId = $(this).val();
                const $itemRow = $(this).closest('[data-item]');
                const $proveedorSelect = $itemRow.find('[name*="[proveedor_sugerido_id]"]');
                const $precioInput = $itemRow.find('.item-precio');
                const $monedaInput = $itemRow.find('.item-moneda');
                
                if (!bienId) {
                    // Si no hay bien seleccionado, mostrar mensaje
                    $proveedorSelect.html('<option value="">Seleccione un bien primero</option>');
                    $precioInput.val('');
                    $monedaInput.val('');
                    calcularMontoTotal();
                    return;
                }
                
                // Cargar proveedores asociados al bien
                $.ajax({
                    url: `/api/ordenes-compra/bienes/${bienId}/proveedores`,
                    method: 'GET',
                    success: function(response) {
                        if (response.success && response.data && response.data.length > 0) {
                            let options = '<option value="">---------</option>';
                            response.data.forEach(proveedor => {
                                const nombre = proveedor.nombre || 'Sin nombre';
                                const precio = proveedor.precio ? ` - ${proveedor.moneda} ${proveedor.precio}` : '';
                                options += `<option value="${proveedor.id}" data-precio="${proveedor.precio || 0}" data-moneda="${proveedor.moneda || ''}">${nombre}${precio}</option>`;
                            });
                            $proveedorSelect.html(options);
                            $precioInput.val('');
                            $monedaInput.val('');
                        } else {
                            $proveedorSelect.html('<option value="">Sin proveedores asociados</option>');
                            $precioInput.val('');
                            $monedaInput.val('');
                        }
                        calcularMontoTotal();
                    },
                    error: function(xhr, status, error) {
                        console.error('Error al cargar proveedores:', error);
                        $proveedorSelect.html('<option value="">Error al cargar proveedores</option>');
                        $precioInput.val('');
                        $monedaInput.val('');
                        calcularMontoTotal();
                    }
                });
            });

            // Event listeners para calcular total en tiempo real
            $(`[data-item="${itemCounter}"] .item-cantidad`).on('input change', calcularMontoTotal);
            $(`[data-item="${itemCounter}"] .item-precio`).on('input change', calcularMontoTotal);
            
            // Event listener para cuando se selecciona un proveedor (auto-completar precio)
            $(`[data-item="${itemCounter}"] [name*="[proveedor_sugerido_id]"]`).on('change', function() {
                const $selected = $(this).find('option:selected');
                const precio = $selected.data('precio');
                const moneda = $selected.data('moneda') || '';
                const itemId = $(this).closest('[data-item]').data('item');
                const $itemRow = $(`[data-item="${itemId}"]`);
                
                if (precio && precio > 0) {
                    $itemRow.find('.item-precio').val(precio);
                } else {
                    $itemRow.find('.item-precio').val('');
                }

                $itemRow.find('.item-moneda').val(moneda);
                calcularMontoTotal();
            });
        }

        function actualizarListaArchivos() {
            const listaArchivos = $('#listaArchivos');
            
            if (archivosSeleccionados.length === 0) {
                listaArchivos.html('<small class="text-muted">No hay archivos seleccionados</small>');
                return;
            }
            
            let html = '<div class="list-group list-group-flush">';
            archivosSeleccionados.forEach((archivo, index) => {
                const tamañoMB = (archivo.size / (1024 * 1024)).toFixed(2);
                const icono = obtenerIconoArchivo(archivo.name);
                
                html += `
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2 px-2">
                        <div class="d-flex align-items-center">
                            <i class="bi ${icono} me-2 text-primary"></i>
                            <div>
                                <small class="fw-bold d-block">${archivo.name}</small>
                                <small class="text-muted">${tamañoMB} MB</small>
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-danger" onclick="eliminarArchivo(${index})" title="Eliminar">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                `;
            });
            html += '</div>';
            
            listaArchivos.html(html);
        }

        function obtenerIconoArchivo(nombre) {
            const extension = nombre.split('.').pop().toLowerCase();
            const iconos = {
                'pdf': 'bi-file-pdf-fill',
                'doc': 'bi-file-word-fill',
                'docx': 'bi-file-word-fill',
                'xls': 'bi-file-excel-fill',
                'xlsx': 'bi-file-excel-fill',
                'jpg': 'bi-file-image-fill',
                'jpeg': 'bi-file-image-fill',
                'png': 'bi-file-image-fill',
                'dwg': 'bi-file-earmark-fill'
            };
            return iconos[extension] || 'bi-file-earmark-fill';
        }

        function eliminarArchivo(index) {
            archivosSeleccionados.splice(index, 1);
            actualizarListaArchivos();
        }

        function eliminarItem(itemId) {
            const itemsCount = $('.item-row').length;
            if (itemsCount <= 1) {
                mostrarAlerta('Debe haber al menos un item en la orden', 'warning');
                return;
            }
            $(`[data-item="${itemId}"]`).remove();
            calcularMontoTotal();
        }

        function obtenerClaveMoneda(moneda) {
            return String(moneda || 'SIN_MONEDA').replace(/[^a-zA-Z0-9_-]/g, '_').toUpperCase();
        }

        function obtenerTotalesPorMonedaItems() {
            const totales = {};

            $('.item-row').each(function() {
                const cantidad = parseFloat($(this).find('.item-cantidad').val()) || 0;
                const precio = parseFloat($(this).find('.item-precio').val()) || 0;
                const moneda = ($(this).find('.item-moneda').val() || '').trim().toUpperCase();

                if (!moneda || cantidad <= 0 || precio <= 0) return;

                if (!totales[moneda]) totales[moneda] = 0;
                totales[moneda] += (cantidad * precio);
            });

            const impuestos = parseFloat($('#impuestos').val()) || 0;
            const descuento = parseFloat($('#descuento').val()) || 0;
            const ajusteNeto = impuestos - descuento;

            if (ajusteNeto !== 0) {
                const monedas = Object.keys(totales);
                const monedaAjuste = monedas[0] || 'ARS';
                totales[monedaAjuste] = Math.max((totales[monedaAjuste] || 0) + ajusteNeto, 0);
            }

            return totales;
        }

        function calcularMontoTotal() {
            reconstruirPlanesCuotasPorMoneda();
        }

        function reconstruirPlanesCuotasPorMoneda() {
            if (!$('#contrafactura').is(':checked')) return;

            const totalesPorMoneda = obtenerTotalesPorMonedaItems();
            const $container = $('#planesCuotasContainer');

            const estadoActualPlanes = {};
            $container.find('.plan-cuotas-moneda').each(function() {
                const moneda = ($(this).data('moneda') || '').toString().toUpperCase();
                if (!moneda) return;

                estadoActualPlanes[moneda] = {
                    adelanto: $(this).find('.adelanto-moneda').val() || '',
                    fechaAdelanto: $(this).find('.fecha-adelanto-moneda').val() || '',
                    cantidadCuotas: $(this).find('.cantidad-cuotas-moneda').val() || '1'
                };
            });

            $container.empty();

            const monedas = Object.keys(totalesPorMoneda).filter(m => totalesPorMoneda[m] > 0);

            if (monedas.length === 0) {
                $container.html(`
                    <div class="alert alert-info py-2 mb-3">
                        <i class="bi bi-info-circle me-2"></i>
                        <small>Seleccione bienes/proveedores con precio para generar planes de cuotas por moneda.</small>
                    </div>
                `);
                return;
            }

            monedas.forEach(moneda => {
                const clave = obtenerClaveMoneda(moneda);
                const montoTotal = totalesPorMoneda[moneda] || 0;
                const estadoMoneda = estadoActualPlanes[moneda] || {};
                const adelantoIngresado = parseFloat(estadoMoneda.adelanto) || 0;
                const adelantoAplicado = Math.min(adelantoIngresado, montoTotal);
                const montoDisponible = Math.max(montoTotal - adelantoAplicado, 0);
                const mensajeAdelanto = (adelantoIngresado > montoTotal)
                    ? `El adelanto supera el total de bienes en ${moneda}. Se toma el máximo posible.`
                    : '';

                const card = `
                    <div class="card mb-3 shadow-sm plan-cuotas-moneda" data-moneda="${moneda}" data-clave="${clave}">
                        <div class="card-header bg-info text-white">
                            <h6 class="mb-0">
                                <i class="bi bi-calendar-event me-2"></i>Plan de Cuotas - ${moneda}
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="alert alert-info py-2 mb-3">
                                <i class="bi bi-info-circle me-2"></i>
                                <small>Configure las cuotas de pago para ${moneda}. Puede personalizar monto y fecha de cada cuota.</small>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-3">
                                    <label class="form-label"><i class="bi bi-calculator me-1"></i>Monto Total de Bienes (${moneda})</label>
                                    <div class="input-group">
                                        <span class="input-group-text">${moneda}</span>
                                        <input type="text" class="form-control fw-bold text-success monto-total-moneda" readonly value="${montoTotal.toFixed(2)}">
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label"><i class="bi bi-cash-coin me-1"></i>Adelanto (${moneda})</label>
                                    <div class="input-group">
                                        <span class="input-group-text">${moneda}</span>
                                        <input type="number" class="form-control adelanto-moneda" data-moneda="${moneda}" step="0.01" min="0" placeholder="0.00" value="${adelantoIngresado > 0 ? adelantoIngresado.toFixed(2) : ''}">
                                    </div>
                                    <small class="text-muted">Opcional</small>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label"><i class="bi bi-cash-stack me-1"></i>Monto Disponible (${moneda})</label>
                                    <div class="input-group">
                                        <span class="input-group-text">${moneda}</span>
                                        <input type="text" class="form-control fw-bold text-primary monto-disponible-moneda" readonly value="${montoDisponible.toFixed(2)}">
                                    </div>
                                    ${mensajeAdelanto ? `<small class="text-warning">${mensajeAdelanto}</small>` : '<small class="text-muted">Total - Adelanto (si aplica)</small>'}
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label"><i class="bi bi-list-ol me-1"></i>Cantidad de Cuotas <span class="text-danger">*</span></label>
                                    <input type="number" class="form-control cantidad-cuotas-moneda" data-moneda="${moneda}" min="1" max="60" value="${estadoMoneda.cantidadCuotas || '1'}" required>
                                    <small class="text-muted">Entre 1 y 60 cuotas</small>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label class="form-label"><i class="bi bi-calendar-check me-1"></i>Fecha Seña (${moneda})</label>
                                    <input type="date" class="form-control fecha-adelanto-moneda" data-moneda="${moneda}" value="${estadoMoneda.fechaAdelanto || ''}">
                                </div>
                            </div>

                            <h6 class="mb-2">
                                <i class="bi bi-list-check me-2"></i>Detalle de Cuotas
                                <span class="badge bg-primary badge-total-cuotas-moneda">1</span>
                            </h6>

                            <div class="table-responsive" style="max-height: 350px; overflow-y: auto;">
                                <table class="table table-bordered table-sm mb-0">
                                    <thead class="table-light sticky-top">
                                        <tr>
                                            <th style="width: 100px;">#</th>
                                            <th style="width: 200px;">Fecha <span class="text-danger">*</span></th>
                                            <th>Monto <span class="text-danger">*</span></th>
                                        </tr>
                                    </thead>
                                    <tbody id="tablaCuotasOC_${clave}"></tbody>
                                    <tfoot class="table-secondary">
                                        <tr>
                                            <td colspan="2" class="text-end"><strong>Total Cuotas:</strong></td>
                                            <td><strong class="total-cuotas-moneda">${moneda} 0.00</strong></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <div class="row mt-3">
                                <div class="col-md-6">
                                    <small class="text-muted">Total a Pagar (${moneda}):</small>
                                    <div class="text-primary fw-bold fs-5 total-pagar-moneda">${moneda} 0.00</div>
                                </div>
                                <div class="col-md-6">
                                    <small class="text-muted">Diferencia:</small>
                                    <div class="fw-bold diferencia-cuotas-moneda">${moneda} 0.00</div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;

                $container.append(card);
                generarCuotasMoneda(moneda);
            });
        }

        function generarCuotasMoneda(moneda) {
            const clave = obtenerClaveMoneda(moneda);
            const $card = $(`.plan-cuotas-moneda[data-clave="${clave}"]`);
            if ($card.length === 0) return;

            const $cantidadInput = $card.find('.cantidad-cuotas-moneda');
            const cantidadCuotas = parseInt($cantidadInput.val()) || 0;

            if (cantidadCuotas < 1 || cantidadCuotas > 60) {
                $card.find(`#tablaCuotasOC_${clave}`).html('<tr><td colspan="3" class="text-center text-muted">Ingrese una cantidad válida de cuotas (1-60)</td></tr>');
                $card.find('.badge-total-cuotas-moneda').text('0');
                actualizarTotalesCuotasMoneda(moneda);
                return;
            }

            $card.find('.badge-total-cuotas-moneda').text(cantidadCuotas);

            const montoDisponible = parseFloat($card.find('.monto-disponible-moneda').val()) || 0;
            const montoCuota = cantidadCuotas > 0 ? (montoDisponible / cantidadCuotas).toFixed(2) : '0.00';

            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);

            const $tbody = $card.find(`#tablaCuotasOC_${clave}`);
            $tbody.empty();

            for (let i = 0; i < cantidadCuotas; i++) {
                const fechaCuota = new Date(tomorrow);
                fechaCuota.setMonth(fechaCuota.getMonth() + i);
                const fechaFormatted = fechaCuota.toISOString().split('T')[0];

                $tbody.append(`
                    <tr>
                        <td class="align-middle text-center"><strong>Cuota ${i + 1}</strong></td>
                        <td>
                            <input type="date" class="form-control form-control-sm fecha-cuota-moneda" data-moneda="${moneda}" data-index="${i}" value="${fechaFormatted}" required>
                        </td>
                        <td>
                            <input type="number" class="form-control form-control-sm monto-cuota-moneda" data-moneda="${moneda}" data-index="${i}" step="0.01" min="0.01" value="${montoCuota}" required>
                        </td>
                    </tr>
                `);
            }

            actualizarTotalesCuotasMoneda(moneda);
        }

        function actualizarTotalesCuotasMoneda(moneda) {
            const clave = obtenerClaveMoneda(moneda);
            const $card = $(`.plan-cuotas-moneda[data-clave="${clave}"]`);
            if ($card.length === 0) return;

            const montoDisponible = parseFloat($card.find('.monto-disponible-moneda').val()) || 0;
            let totalCuotas = 0;

            $card.find('.monto-cuota-moneda').each(function() {
                totalCuotas += parseFloat($(this).val()) || 0;
            });

            const diferencia = totalCuotas - montoDisponible;

            $card.find('.total-cuotas-moneda').text(`${moneda} ${totalCuotas.toFixed(2)}`);
            $card.find('.total-pagar-moneda').text(`${moneda} ${totalCuotas.toFixed(2)}`);

            const $diferencia = $card.find('.diferencia-cuotas-moneda');
            if (diferencia > 0.01) {
                $diferencia.text(`+${moneda} ${diferencia.toFixed(2)}`);
                $diferencia.removeClass('text-success text-muted').addClass('text-danger');
            } else if (diferencia < -0.01) {
                $diferencia.text(`${moneda} ${diferencia.toFixed(2)}`);
                $diferencia.removeClass('text-danger text-muted').addClass('text-success');
            } else {
                $diferencia.text(`${moneda} 0.00`);
                $diferencia.removeClass('text-danger text-success').addClass('text-muted');
            }
        }

        function eliminarItem(itemId) {
            const itemsCount = $('.item-row').length;
            if (itemsCount <= 1) {
                mostrarAlerta('Debe haber al menos un item en la orden', 'warning');
                return;
            }
            $(`[data-item="${itemId}"]`).remove();
            calcularMontoTotal();
        }

        function guardarOrden() {
            const formData = new FormData();
            
            // Datos generales
            formData.append('proveedor_id', $('#proveedor_id').val() || '');
            formData.append('condicion', $('#condicion').val());
            formData.append('fecha_entrega_solicitada', $('#fecha_entrega_solicitada').val() || '');
            formData.append('fecha_entrega_proveedor', $('#fecha_entrega_proveedor').val() || '');
            formData.append('asunto', $('#asunto').val() || '');
            formData.append('contrafactura', $('#contrafactura').is(':checked') ? 'true' : 'false');
            formData.append('impuestos', $('#contrafactura').is(':checked') ? ($('#impuestos').val() || '0') : '0');
            formData.append('descuento', $('#contrafactura').is(':checked') ? ($('#descuento').val() || '0') : '0');
            
            // Si es contrafactura, incluir adelanto y cuotas
            if ($('#contrafactura').is(':checked')) {
                // Validar y recopilar cuotas de todos los planes por moneda
                const cuotas = [];
                const $planes = $('.plan-cuotas-moneda');
                const adelantosPorMoneda = [];
                let numeroCuotaGlobal = 1;
                
                if ($planes.length === 0) {
                    mostrarAlerta('No hay planes de cuotas generados. Verifique que los items tengan precio y moneda.', 'warning');
                    return;
                }

                for (const plan of $planes.toArray()) {
                    const $plan = $(plan);
                    const moneda = ($plan.data('moneda') || '').toString().toUpperCase();
                    const montoDisponible = parseFloat($plan.find('.monto-disponible-moneda').val()) || 0;
                    const montoTotalMoneda = parseFloat($plan.find('.monto-total-moneda').val()) || 0;
                    const adelantoMoneda = parseFloat($plan.find('.adelanto-moneda').val()) || 0;
                    const fechaAdelantoMoneda = $plan.find('.fecha-adelanto-moneda').val() || '';
                    let totalCuotasPlan = 0;

                    const $montos = $plan.find('.monto-cuota-moneda');
                    const $fechas = $plan.find('.fecha-cuota-moneda');

                    if (adelantoMoneda > montoTotalMoneda + 0.01) {
                        mostrarAlerta(`El adelanto en ${moneda} no puede ser mayor al total de bienes (${moneda} ${montoTotalMoneda.toFixed(2)}).`, 'warning');
                        return;
                    }

                    if (adelantoMoneda > 0) {
                        adelantosPorMoneda.push({
                            moneda,
                            monto: adelantoMoneda,
                            fecha: fechaAdelantoMoneda || null
                        });
                    }

                    if ($montos.length === 0) {
                        mostrarAlerta(`El plan de ${moneda} no tiene cuotas generadas.`, 'warning');
                        return;
                    }

                    for (let i = 0; i < $montos.length; i++) {
                        const fecha = $($fechas[i]).val();
                        const monto = parseFloat($($montos[i]).val());

                        if (!fecha) {
                            mostrarAlerta(`La cuota ${i + 1} del plan ${moneda} debe tener una fecha`, 'warning');
                            return;
                        }

                        if (!monto || monto <= 0) {
                            mostrarAlerta(`La cuota ${i + 1} del plan ${moneda} debe tener un monto mayor a 0`, 'warning');
                            return;
                        }

                        totalCuotasPlan += monto;
                        cuotas.push({
                            numeroCuota: numeroCuotaGlobal++,
                            fecha,
                            monto,
                            moneda,
                            observacion: `Cuota ${i + 1} (${moneda})`
                        });
                    }

                    const diferenciaPlan = totalCuotasPlan - montoDisponible;
                    if (diferenciaPlan > 0.01) {
                        mostrarAlerta(
                            `El total de cuotas del plan ${moneda} (${moneda} ${totalCuotasPlan.toFixed(2)}) supera el monto disponible (${moneda} ${montoDisponible.toFixed(2)}). Diferencia: +${moneda} ${diferenciaPlan.toFixed(2)}`,
                            'warning'
                        );
                        return;
                    }
                }

                // Compatibilidad con backend actual (solo soporta un adelanto global)
                if (adelantosPorMoneda.length === 1) {
                    formData.append('monto_adelanto', adelantosPorMoneda[0].monto);
                    formData.append('moneda_adelanto', adelantosPorMoneda[0].moneda);
                    formData.append('fecha_adelanto', adelantosPorMoneda[0].fecha || '');
                } else {
                    formData.append('monto_adelanto', '');
                    formData.append('moneda_adelanto', 'ARS');
                    formData.append('fecha_adelanto', '');
                }

                formData.append('adelantos_por_moneda', JSON.stringify(adelantosPorMoneda));
                formData.append('cuotas', JSON.stringify(cuotas));
            } else {
                // Si no es contrafactura, limpiar campos relacionados
                formData.append('monto_adelanto', '');
                formData.append('moneda_adelanto', 'ARS');
                formData.append('fecha_adelanto', '');
                formData.append('adelantos_por_moneda', '[]');
            }
            
            console.log('Contrafactura checkbox:', $('#contrafactura').is(':checked'));
            console.log('Valor enviado:', $('#contrafactura').is(':checked') ? 'true' : 'false');
            console.log('Adelantos por moneda:', formData.get('adelantos_por_moneda'));
            
            // Archivos adjuntos desde el array
            if (archivosSeleccionados.length > 0) {
                archivosSeleccionados.forEach(archivo => {
                    formData.append('archivos', archivo);
                });
            }

            // Recolectar items
            const items = [];
            $('.item-row').each(function() {
                const item = {
                    bien_id: $(this).find('[name*="[bien_id]"]').val(),
                    centro_costo: $(this).find('[name*="[centro_costo]"]').val() || null,
                    descripcion: $(this).find('[name*="[descripcion]"]').val() || null,
                    cantidad: parseFloat($(this).find('[name*="[cantidad]"]').val()) || 0,
                    precio_unitario: parseFloat($(this).find('.item-precio').val()) || 0,
                    medio_pago: $(this).find('[name*="[medio_pago]"]').val(),
                    unidad_medida_id: $(this).find('[name*="[unidad_medida_id]"]').val() || null,
                    proveedor_sugerido_id: $(this).find('[name*="[proveedor_sugerido_id]"]').val() || null
                };
                
                if (item.bien_id && item.cantidad > 0) {
                    items.push(item);
                }
            });

            if (items.length === 0) {
                mostrarAlerta('Debe agregar al menos un item válido', 'warning');
                return;
            }

            if (items.some(item => !item.proveedor_sugerido_id)) {
                $('#formNuevaOrden').addClass('was-validated');
                mostrarAlerta('Debe seleccionar un proveedor para cada item', 'warning');
                return;
            }

            formData.append('items', JSON.stringify(items));

            $('#btnGuardar').prop('disabled', true).html('<i class="spinner-border spinner-border-sm me-1"></i>Guardando...');

            $.ajax({
                url: '/api/ordenes-compra/nuevo',
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}` },
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    if (response.success) {
                        mostrarAlerta('Orden de compra creada exitosamente', 'success');
                        setTimeout(() => {
                            window.location.href = '/ordenes-compra';
                        }, 1500);
                    }
                },
                error: function(xhr) {
                    const error = xhr.responseJSON?.error || 'Error al crear orden de compra';
                    mostrarAlerta(error, 'danger');
                    $('#btnGuardar').prop('disabled', false).html('<i class="bi bi-save me-1"></i>Guardar Orden de Compra');
                }
            });
        }

        function mostrarAlerta(mensaje, tipo) {
            const alerta = `
                <div class="alert alert-${tipo} alert-dismissible fade show" role="alert">
                    ${mensaje}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            $('#alertPlaceholder').html(alerta);
            setTimeout(() => $('.alert').alert('close'), 5000);
        }
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="es-AR">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Detalle Falla - Regomax</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"><link rel="stylesheet" href="/assets/css/home.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary"><div class="container-fluid"><a class="navbar-brand d-flex align-items-center" href="/home"><img src="/assets/img/regomax.png" alt="Regomax Logo" class="bg-white rounded p-1"><span class="ms-2 fw-bold">Regomax S.A.</span></a><div class="collapse navbar-collapse show"><ul class="navbar-nav ms-auto"><li class="nav-item"><span class="nav-link text-light">BIENVENIDO/A, <b><%= username %></b></span></li><li class="nav-item"><a class="nav-link" href="#" id="logout-link"><i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión</a></li></ul></div></div></nav>
    <main class="container my-4"><div class="menu-container p-4">
        <div class="d-flex justify-content-between align-items-center mb-4"><h4 class="menu-heading mb-0"><i class="bi bi-tools me-2"></i>Detalle de la Falla</h4><a href="/fallas/editar/<%= falla.id %>" class="btn btn-warning"><i class="bi bi-pencil me-2"></i>Editar</a></div>
        <div class="card"><div class="card-body"><label class="form-label fw-bold">Nombre:</label><p class="form-control-plaintext"><%= falla.nombre %></p><label class="form-label fw-bold">Responsable:</label><p class="form-control-plaintext"><%= falla.responsable || '-' %></p><label class="form-label fw-bold">Fecha de creación:</label><p class="form-control-plaintext"><%= falla.fecha_creacion ? new Date(falla.fecha_creacion).toLocaleString('es-AR') : '-' %></p></div></div>
        <div class="mt-4"><a href="/fallas" class="btn btn-secondary"><i class="bi bi-arrow-left me-2"></i>Volver al Listado</a></div>
    </div></main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script><script src="https://code.jquery.com/jquery-3.6.0.min.js"></script><script src="/assets/js/common.js"></script>
</body></html>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalle Máquina - Regomax</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/assets/css/home.css">
</head>
<body data-allow-back-navigation="true">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="/home">
                <img src="/assets/img/regomax.png" alt="Regomax Logo" class="bg-white rounded p-1">
                <span class="ms-2 fw-bold">Regomax S.A.</span>
            </a>
            <div class="collapse navbar-collapse show">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item user-welcome me-3">
                        <span class="text-light">BIENVENIDO/A, <b><%= username %></b></span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#" id="logout-link"><i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container my-4">
        <div class="menu-container p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="menu-heading mb-0"><i class="bi bi-gear-wide-connected me-2"></i>Detalle de la Máquina</h4>
                <a href="/maquinas/editar/<%= maquina.id %>" class="btn btn-warning" id="editLink">
                    <i class="bi bi-pencil me-2"></i>Editar
                </a>
            </div>

            <div class="card">
                <div class="card-body">
                    <label class="form-label fw-bold">Nombre:</label>
                    <p class="form-control-plaintext"><%= maquina.nombre %></p>
                    <label class="form-label fw-bold">Descripción:</label>
                    <p class="form-control-plaintext text-break"><%= maquina.descripcion || '-' %></p>
                    <label class="form-label fw-bold">Responsable:</label>
                    <p class="form-control-plaintext"><%= maquina.responsable || '-' %></p>
                </div>
            </div>

            <div class="mt-4">
                <a href="/maquinas" class="btn btn-secondary" id="backToList">
                    <i class="bi bi-arrow-left me-2"></i>Volver al Listado
                </a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/assets/js/common.js"></script>
    <script>
        const returnTo = new URLSearchParams(window.location.search).get('returnTo');
        if (returnTo === '/maquinas' || returnTo?.startsWith('/maquinas?')) {
            document.getElementById('backToList').href = returnTo;
            const editUrl = new URL(document.getElementById('editLink').href, window.location.origin);
            editUrl.searchParams.set('returnTo', returnTo);
            document.getElementById('editLink').href = editUrl.pathname + editUrl.search;
        }
    </script>
</body>
</html>

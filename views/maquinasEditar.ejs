<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Máquina - Regomax</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/assets/css/home.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="/home">
                <img src="/assets/img/regomax.png" alt="Regomax Logo" class="bg-white rounded p-1">
                <span class="ms-2 fw-bold">Regomax S.A.</span>
            </a>
            <div class="collapse navbar-collapse show">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item user-welcome me-3">
                        <span class="text-light">BIENVENIDO/A, <b><%= username %></b></span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#" id="logout-link"><i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container my-4">
        <div class="menu-container p-4">
            <h4 class="menu-heading mb-4"><i class="bi bi-pencil me-2"></i>Editar Máquina</h4>
            <div id="alertPlaceholder"></div>

            <form id="formEditarMaquina" class="needs-validation" novalidate>
                <input type="hidden" id="maquinaId" value="<%= maquina.id %>">
                <div class="mb-3">
                    <label for="nombre" class="form-label">Nombre de la Máquina <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="nombre" name="nombre" value="<%= maquina.nombre %>" required>
                    <div class="invalid-feedback">Por favor ingrese el nombre de la máquina.</div>
                </div>
                <button type="submit" id="submitBtn" class="btn btn-primary">
                    <i class="bi bi-save me-2"></i>Guardar Cambios
                </button>
                <a href="/maquinas/<%= maquina.id %>" class="btn btn-outline-secondary ms-2">
                    <i class="bi bi-x-circle me-2"></i>Cancelar
                </a>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/assets/js/common.js"></script>
    <script>
        $(document).ready(function() {
            const form = $('#formEditarMaquina');
            const submitBtn = $('#submitBtn');
            const maquinaId = $('#maquinaId').val();

            form.on('submit', function(e) {
                e.preventDefault();

                if (!form[0].checkValidity()) {
                    form.addClass('was-validated');
                    return;
                }

                const originalText = submitBtn.html();
                submitBtn.html('<span class="spinner-border spinner-border-sm me-2"></span>Guardando...').prop('disabled', true);

                fetch(`/api/maquinas/${maquinaId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ nombre: $('#nombre').val().trim() })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        window.location.href = `/maquinas/${maquinaId}`;
                    } else {
                        $('#alertPlaceholder').html(`<div class="alert alert-danger">${data.error || 'Error al actualizar la máquina'}</div>`);
                        submitBtn.html(originalText).prop('disabled', false);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    $('#alertPlaceholder').html('<div class="alert alert-danger">Error al actualizar la máquina.</div>');
                    submitBtn.html(originalText).prop('disabled', false);
                });
            });
        });
    </script>
</body>
</html>

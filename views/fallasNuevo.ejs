<!DOCTYPE html>
<html lang="es-AR">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nueva Falla - Regomax</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/assets/css/home.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary"><div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center" href="/home"><img src="/assets/img/regomax.png" alt="Regomax Logo" class="bg-white rounded p-1"><span class="ms-2 fw-bold">Regomax S.A.</span></a>
        <div class="collapse navbar-collapse show"><ul class="navbar-nav ms-auto"><li class="nav-item"><span class="nav-link text-light">BIENVENIDO/A, <b><%= username %></b></span></li><li class="nav-item"><a class="nav-link" href="#" id="logout-link"><i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión</a></li></ul></div>
    </div></nav>
    <main class="container my-4"><div class="menu-container p-4">
        <h4 class="menu-heading mb-4"><i class="bi bi-plus-circle me-2"></i>Nueva Falla</h4>
        <div id="alertPlaceholder"></div>
        <form id="formNuevaFalla" class="needs-validation" novalidate>
            <div class="mb-3"><label for="nombre" class="form-label">Nombre de la Falla <span class="text-danger">*</span></label><input type="text" class="form-control" id="nombre" name="nombre" required><div class="invalid-feedback">Ingrese el nombre de la falla.</div></div>
            <button type="submit" id="submitBtn" class="btn btn-primary"><i class="bi bi-save me-2"></i>Guardar Falla</button>
            <a href="/fallas" class="btn btn-outline-secondary ms-2"><i class="bi bi-x-circle me-2"></i>Cancelar</a>
        </form>
    </div></main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script><script src="https://code.jquery.com/jquery-3.6.0.min.js"></script><script src="/assets/js/common.js"></script>
    <script>
        $('#formNuevaFalla').on('submit', async function(event) {
            event.preventDefault();
            if (!this.checkValidity()) { $(this).addClass('was-validated'); return; }
            const button = $('#submitBtn').prop('disabled', true);
            const response = await fetch('/api/fallas/nuevo', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ nombre: $('#nombre').val().trim() }) });
            const data = await response.json();
            if (response.ok && data.success) window.location.href = '/fallas';
            else { $('#alertPlaceholder').html(`<div class="alert alert-danger">${data.error || 'Error al crear la falla'}</div>`); button.prop('disabled', false); }
        });
    </script>
</body></html>

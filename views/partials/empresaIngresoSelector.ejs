<label for="<%= selectorEmpresaId %>" id="etiquetaEmpresaManual" class="form-label">Empresa <%= typeof movimiento !== 'undefined' && movimiento.motivo === 'Visita' ? '(opcional)' : '*' %></label>
<div class="d-flex gap-2 align-items-start">
    <div class="flex-grow-1" style="min-width: 0;">
        <select id="<%= selectorEmpresaId %>" name="empresa_ingreso_id" class="form-select" data-empresa-ingreso required>
            <option value="">Seleccionar empresa</option>
            <% if (typeof movimiento !== 'undefined' && ['Basura', 'Acero', 'Proveedor', 'Visita'].includes(movimiento.motivo) && movimiento.empresa) { %>
                <option value="actual" selected><%= movimiento.empresa %> (registrada en el ingreso)</option>
            <% } %>
            <% (typeof empresasIngresos !== 'undefined' ? empresasIngresos : []).forEach(empresa => { %><option value="<%= empresa.id %>"><%= empresa.nombre %></option><% }); %>
        </select>
    </div>
    <button type="button" class="btn btn-outline-primary" data-empresa-nueva data-selector-empresa="<%= selectorEmpresaId %>" title="Agregar empresa" aria-label="Agregar empresa"><i class="bi bi-plus-lg" aria-hidden="true"></i></button>
</div>
<div class="form-text"><a href="/empresas-ingresos" target="_blank" rel="noopener noreferrer">Administrar empresas</a></div>
<% if (typeof errorEmpresasIngresos !== 'undefined' && errorEmpresasIngresos) { %><div class="text-warning small mt-2">No se pudieron cargar las empresas. Recargue para intentar nuevamente.</div><% } %>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ingresos - Regomax</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/home.css">
</head>
<body data-allow-back-navigation="true">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="/home">
                <img src="/assets/img/regomax.png" alt="Regomax Logo" class="bg-white rounded p-1">
                <span class="ms-2 fw-bold">Regomax S.A.</span>
            </a>
            <div class="collapse navbar-collapse show">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item user-welcome me-3">
                        <span class="text-light">BIENVENIDO/A, <b><%= username %></b></span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#" id="logout-link"><i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container my-4">
        <div class="menu-container p-4">
            <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
                <h4 class="menu-heading mb-0"><i class="bi bi-person-vcard me-2"></i>Ingresos</h4>
                <a href="/ingresos/listado" class="btn btn-outline-primary">Ver listado</a>
            </div>
            <div id="alertPlaceholder" role="status" aria-live="polite"></div>
            <div class="d-flex flex-wrap gap-2 mb-4">
                <a href="/ingresos" class="btn btn-primary" aria-current="page"><i class="bi bi-person-vcard me-1" aria-hidden="true"></i>Ingreso con DNI</a>
                <a href="/ingresos/personal" class="btn btn-outline-primary"><i class="bi bi-people me-1" aria-hidden="true"></i>Ingreso de personal</a>
                <a href="/personal" class="btn btn-outline-secondary">Administrar personal</a>
            </div>

            <form id="formIdentificar" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="entrada" class="form-label">DNI o escaneo del documento <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="entrada" name="entrada" maxlength="1000" autocomplete="off" autofocus required aria-describedby="ayudaDni">
                    <div id="ayudaDni" class="form-text">Escanee el DNI o ingrese el número sin puntos y presione Enter o Continuar.</div>
                    <div class="invalid-feedback">Ingrese el DNI o escanee el documento.</div>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-arrow-right me-2"></i>Continuar</button>
                <a href="/home" class="btn btn-outline-secondary ms-2">Volver</a>
            </form>

            <form id="formPersona" class="needs-validation d-none" novalidate>
                <p class="text-muted">La persona no está registrada. Complete sus datos para continuar.</p>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label for="nombre" class="form-label">Nombre <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="nombre" name="nombre" maxlength="100" required>
                        <div class="invalid-feedback">Ingrese el nombre.</div>
                    </div>
                    <div class="col-md-6">
                        <label for="apellido" class="form-label">Apellido <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="apellido" name="apellido" maxlength="100" required>
                        <div class="invalid-feedback">Ingrese el apellido.</div>
                    </div>
                    <div class="col-md-6">
                        <label for="dni" class="form-label">DNI <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="dni" name="dni" readonly required>
                    </div>
                    <div class="col-md-6">
                        <label for="sexo" class="form-label">Sexo <span class="text-danger">*</span></label>
                        <select class="form-select" id="sexo" name="sexo" required>
                            <option value="">Seleccione...</option>
                            <option value="M">Masculino</option>
                            <option value="F">Femenino</option>
                            <option value="X">X</option>
                        </select>
                        <div class="invalid-feedback">Seleccione el sexo.</div>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-2"></i>Registrar y continuar</button>
                <button type="button" class="btn btn-outline-secondary ms-2" data-reiniciar>Cambiar DNI</button>
            </form>

            <div id="personaSeleccionada" class="d-none">
                <div class="alert alert-success" role="status">Persona identificada correctamente.</div>
                <dl class="row mb-3">
                    <dt class="col-sm-3">Nombre</dt><dd class="col-sm-9" id="personaNombre"></dd>
                    <dt class="col-sm-3">Apellido</dt><dd class="col-sm-9" id="personaApellido"></dd>
                    <dt class="col-sm-3">DNI</dt><dd class="col-sm-9" id="personaDni"></dd>
                    <dt class="col-sm-3">Sexo</dt><dd class="col-sm-9" id="personaSexo"></dd>
                </dl>
                <form id="formMotivoIngreso" class="needs-validation mb-4" enctype="multipart/form-data" novalidate>
                    <div class="mb-3">
                        <label for="motivoIngreso" class="form-label">Motivo de ingreso <span class="text-danger">*</span></label>
                        <select class="form-select" id="motivoIngreso" name="motivo" required aria-controls="camposNFU camposLogistica camposBasura camposVehiculo">
                            <option value="">Seleccione un motivo</option>
                            <option value="CNFU/NFU">CNFU/NFU</option>
                            <option value="Logística">Logística</option>
                            <option value="Basura">Basura</option>
                            <option value="Acero">Acero</option>
                            <option value="Proveedor">Proveedor</option>
                            <option value="Visita">Visita</option>
                        </select>
                    </div>
                    <fieldset id="camposNFU" class="d-none" disabled>
                        <legend class="fs-6">Datos del ingreso CNFU/NFU</legend>
                        <% if (errorClientes) { %>
                            <div class="alert alert-warning" role="alert">No se pudieron cargar las empresas. Recargue la página para intentar nuevamente.</div>
                        <% } else if (!clientes.length) { %>
                            <div class="alert alert-info">No hay clientes NFU registrados.</div>
                        <% } %>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="cliente_id" class="form-label">Empresa <span class="text-danger">*</span></label>
                                <select class="form-select" id="cliente_id" name="cliente_id" required aria-describedby="ayudaEmpresa">
                                    <option value="">Seleccionar cliente</option>
                                    <% clientes.forEach(cliente => { %>
                                        <option value="<%= cliente.id %>"><%= cliente.empresa %> - <%= cliente.cuit %></option>
                                    <% }); %>
                                </select>
                                <div id="ayudaEmpresa" class="form-text">Busque escribiendo el nombre o CUIT del cliente NFU.</div>
                            </div>
                            <div class="col-md-6">
                                <label for="tipo" class="form-label">Tipo <span class="text-danger">*</span></label>
                                <select class="form-select" id="tipo" name="tipo" required>
                                    <option value="">Seleccionar tipo</option>
                                    <option value="Auto">Auto</option>
                                    <option value="Camion">Camión</option>
                                    <option value="Mix">Mix</option>
                                    <option value="Otros">Otros</option>
                                </select>
                            </div>
                        </div>
                    </fieldset>
                    <fieldset id="camposLogistica" class="d-none" disabled>
                        <legend class="fs-6">Datos del ingreso de logística</legend>
                        <% if (errorOrdenes) { %>
                            <div class="alert alert-warning" role="alert">No se pudieron cargar las órdenes de venta. Recargue la página para intentar nuevamente.</div>
                        <% } else if (!ordenesVenta.length) { %>
                            <div class="alert alert-info">No hay órdenes de venta abiertas o en logística.</div>
                        <% } %>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="orden_venta_id" class="form-label">Orden de venta <span class="text-danger">*</span></label>
                                <select class="form-select" id="orden_venta_id" name="orden_venta_id" required aria-describedby="ayudaOrdenVenta">
                                    <option value="">Seleccionar orden de venta</option>
                                    <% ordenesVenta.forEach(orden => { %>
                                        <option value="<%= orden.id %>" data-cliente-final="<%= orden.cliente_final || '' %>"><%= orden.cliente_final || 'Sin cliente final' %> — <%= orden.codigo_venta || 'OV-' + orden.id %> (<%= orden.estado === 'abierta' ? 'Abierta' : 'En logística' %>)</option>
                                    <% }); %>
                                </select>
                                <div id="ayudaOrdenVenta" class="form-text">Busque por cliente final o código de venta.</div>
                            </div>
                            <div class="col-md-6">
                                <label for="empresaLogistica" class="form-label">Empresa <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="empresaLogistica" readonly required placeholder="Se completa al seleccionar la orden">
                            </div>
                        </div>
                    </fieldset>
                    <fieldset id="camposBasura" class="d-none" disabled>
                        <legend class="fs-6">Datos de la empresa</legend>
                        <div class="mt-3">
                            <label for="empresaBasura" id="etiquetaEmpresaManual" class="form-label">Empresa *</label>
                            <input type="text" class="form-control" id="empresaBasura" name="empresa" maxlength="255" required placeholder="Ingrese el nombre de la empresa">
                        </div>
                    </fieldset>
                    <fieldset id="camposVehiculo" class="d-none" disabled>
                        <legend class="visually-hidden">Vehículo</legend>
                        <div class="mt-3">
                            <label for="patente" class="form-label">Patente del vehículo <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="patente" name="patente" maxlength="20" required placeholder="Ej.: AB123CD o ABC123" autocapitalize="characters" spellcheck="false">
                        </div>
                    </fieldset>
                    <div class="mt-3">
                        <label for="descripcion" class="form-label">Descripción (opcional)</label>
                        <textarea id="descripcion" name="descripcion" class="form-control" rows="3" maxlength="2000" placeholder="Observaciones del ingreso"></textarea>
                    </div>
                    <div id="zonaArchivoIngreso" class="border border-2 rounded p-3 mt-3">
                        <label for="archivoIngreso" class="form-label fw-semibold"><i class="bi bi-paperclip me-2" aria-hidden="true"></i>Adjuntar PDF o JPG (opcional)</label>
                        <p id="ayudaArchivoIngreso" class="text-muted small mb-2">Arrastre un archivo aquí o selecciónelo. PDF, JPG o JPEG, hasta 10 MB.</p>
                        <input type="file" class="form-control" id="archivoIngreso" name="archivo_jpg" accept=".jpg,.jpeg,.pdf,image/jpeg,application/pdf" aria-describedby="ayudaArchivoIngreso errorArchivoIngreso">
                        <div id="errorArchivoIngreso" class="text-danger small mt-2" role="alert"></div>
                        <div id="detalleArchivoIngreso" class="d-none mt-3">
                            <img id="vistaArchivoIngreso" class="img-thumbnail d-block mb-2" style="max-height: 200px; max-width: 100%; object-fit: contain;" alt="Vista previa del JPG adjunto">
                            <span id="nombreArchivoIngreso" class="small text-break"></span>
                        </div>
                        <button type="button" id="quitarArchivoIngreso" class="btn btn-outline-secondary btn-sm mt-2 d-none">Quitar archivo</button>
                    </div>
                    <button type="submit" class="btn btn-primary mt-3"><i class="bi bi-save me-2"></i>Guardar ingreso</button>
                </form>
                <button type="button" class="btn btn-outline-secondary" data-reiniciar>Ingresar otro DNI</button>
                <a href="/home" class="btn btn-outline-secondary ms-2">Volver</a>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="/assets/js/common.js"></script>
    <script src="/assets/js/ingresosNuevo.js?v=proveedor-visita-1"></script>
</body>
</html>

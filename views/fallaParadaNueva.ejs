<!DOCTYPE html>
<html lang="es-AR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= modoEdicion ? 'Editar' : 'Nueva' %> Falla / Parada - Regomax</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/home.css">
</head>
<body data-allow-back-navigation="true">
    <% const registro = fallaParada || {}; %>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="/home">
                <img src="/assets/img/regomax.png" alt="Regomax Logo" class="bg-white rounded p-1">
                <span class="ms-2 fw-bold">Regomax S.A.</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item user-welcome me-3">
                        <span class="text-light">BIENVENIDO/A, <b><%= username %></b></span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#" id="logout-link"><i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container my-4">
        <div class="row mb-4">
            <div class="col">
                <div class="menu-container p-4">
                    <h4 class="menu-heading mb-4">
                        <i class="bi bi-exclamation-triangle me-2"></i><%= modoEdicion ? 'Editar' : 'Nueva' %> Falla / Parada
                    </h4>

                    <div id="alertPlaceholder"></div>

                    <form id="formFallaParada" class="needs-validation" novalidate>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label for="fecha" class="form-label">Fecha <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="fecha" name="fecha" value="<%= registro.fecha || '' %>" required>
                                <div class="invalid-feedback">Ingrese la fecha.</div>
                            </div>
                            <div class="col-md-4">
                                <label for="hora" class="form-label">Hora <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="hora" name="hora" value="<%= registro.hora || '' %>"
                                       placeholder="HH:mm" inputmode="numeric" maxlength="5"
                                       pattern="(?:[01][0-9]|2[0-3]):[0-5][0-9]" required>
                                <div class="form-text">Formato 24 horas (HH:mm).</div>
                                <div class="invalid-feedback">Ingrese una hora válida entre 00:00 y 23:59.</div>
                            </div>
                            <div class="col-md-4">
                                <label for="minutos_afectados" class="form-label">Minutos afectados <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="minutos_afectados" name="minutos_afectados" min="0" step="1" value="<%= registro.minutos_afectados ?? '' %>" required>
                                <div class="invalid-feedback">Ingrese una cantidad válida de minutos.</div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label for="maquina" class="form-label">Máquina <span class="text-danger">*</span></label>
                                <select class="form-select" id="maquina" name="maquina" required>
                                    <option value="">Seleccione una máquina</option>
                                    <% if (maquinas && maquinas.length > 0) { %>
                                        <% maquinas.forEach((maquina) => { %>
                                            <option value="<%= maquina.nombre %>" <%= registro.maquina === maquina.nombre ? 'selected' : '' %>><%= maquina.nombre %></option>
                                        <% }) %>
                                    <% } %>
                                </select>
                                <div class="invalid-feedback">Seleccione una máquina.</div>
                            </div>
                            <div class="col-md-4">
                                <label for="falla" class="form-label">Falla <span class="text-danger">*</span></label>
                                <select class="form-select" id="falla" name="falla" required>
                                    <option value="">Seleccione una falla</option>
                                    <% fallas.forEach((falla) => { %>
                                        <% const valorFalla = falla.id || falla.nombre; %>
                                        <option value="<%= valorFalla %>" <%= String(registro.falla) === String(valorFalla) ? 'selected' : '' %>><%= falla.nombre %></option>
                                    <% }) %>
                                </select>
                                <div class="invalid-feedback">Seleccione una falla.</div>
                            </div>
                            <div class="col-md-4">
                                <label for="tipo_parada" class="form-label">Tipo parada <span class="text-danger">*</span></label>
                                <select class="form-select" id="tipo_parada" name="tipo_parada" required>
                                    <option value="">Seleccione un tipo de parada</option>
                                    <% tiposParada.forEach((tipo) => { %>
                                        <option value="<%= tipo %>" <%= registro.tipo_parada === tipo ? 'selected' : '' %>><%= tipo %></option>
                                    <% }) %>
                                </select>
                                <div class="invalid-feedback">Seleccione un tipo de parada.</div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-12">
                                <label for="descripcion" class="form-label">Descripción <span class="text-danger">*</span></label>
                                <textarea class="form-control" id="descripcion" name="descripcion" rows="3" required><%= registro.descripcion || '' %></textarea>
                                <div class="invalid-feedback">Ingrese una descripción.</div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-12">
                                <label for="observaciones" class="form-label">Observaciones</label>
                                <textarea class="form-control" id="observaciones" name="observaciones" rows="3"><%= registro.observaciones || '' %></textarea>
                            </div>
                        </div>

                        <button type="submit" id="submitBtn" class="btn btn-primary">
                            <i class="bi bi-save me-2"></i><%= modoEdicion ? 'Guardar cambios' : 'Guardar Falla / Parada' %>
                        </button>
                        <a href="/mantenimiento/fallas-paradas" class="btn btn-outline-secondary ms-2" id="cancelLink">
                            <i class="bi bi-x-circle me-2"></i>Cancelar
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="/assets/js/common.js"></script>
    <script>
        $(document).ready(function() {
            const requestedReturnTo = new URLSearchParams(window.location.search).get('returnTo');
            const returnTo = requestedReturnTo === '/mantenimiento/fallas-paradas' || requestedReturnTo?.startsWith('/mantenimiento/fallas-paradas?')
                ? requestedReturnTo
                : '/mantenimiento/fallas-paradas';
            $('#cancelLink').attr('href', returnTo);

            const ahora = new Date();
            const anio = ahora.getFullYear();
            const mes = String(ahora.getMonth() + 1).padStart(2, '0');
            const dia = String(ahora.getDate()).padStart(2, '0');
            const horas = String(ahora.getHours()).padStart(2, '0');
            const minutos = String(ahora.getMinutes()).padStart(2, '0');

            if (!$('#fecha').val()) {
                $('#fecha').val(`${anio}-${mes}-${dia}`);
            }
            if (!$('#hora').val()) {
                $('#hora').val(`${horas}:${minutos}`);
            }

            $('#hora').on('input', function() {
                let valor = this.value.replace(/\D/g, '').slice(0, 4);
                if (valor.length > 2) {
                    valor = `${valor.slice(0, 2)}:${valor.slice(2)}`;
                }
                this.value = valor;
            });

            $('#maquina, #falla').select2({
                theme: 'bootstrap-5',
                width: '100%',
                allowClear: true
            });

            $('#formFallaParada').on('submit', async function(event) {
                event.preventDefault();
                if (!this.checkValidity()) {
                    event.stopPropagation();
                    $(this).addClass('was-validated');
                    return;
                }

                const modoEdicion = <%= modoEdicion ? 'true' : 'false' %>;
                const registroId = '<%= registro.id || '' %>';
                const submitBtn = $('#submitBtn');
                const textoOriginal = submitBtn.html();
                submitBtn.html('<span class="spinner-border spinner-border-sm me-2"></span>Guardando...').prop('disabled', true);

                try {
                    const response = await fetch(
                        modoEdicion ? `/api/fallas-paradas/${registroId}` : '/api/fallas-paradas',
                        {
                            method: modoEdicion ? 'PUT' : 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                fecha: $('#fecha').val(),
                                hora: $('#hora').val(),
                                minutos_afectados: $('#minutos_afectados').val(),
                                maquina: $('#maquina').val(),
                                falla_id: $('#falla').val(),
                                tipo_parada: $('#tipo_parada').val(),
                                descripcion: $('#descripcion').val(),
                                observaciones: $('#observaciones').val()
                            })
                        }
                    );
                    const data = await response.json();

                    if (!response.ok || !data.success) {
                        throw new Error(data.error || 'No se pudo guardar la falla/parada');
                    }

                    window.location.href = returnTo;
                } catch (error) {
                    const alerta = $('<div>').addClass('alert alert-danger').text(error.message);
                    $('#alertPlaceholder').empty().append(alerta);
                    submitBtn.html(textoOriginal).prop('disabled', false);
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            });
        });
    </script>
</body>
</html>
